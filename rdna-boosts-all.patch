+    if (ggml_cuda_mmb_res16()) {
+        const ggml_tensor * rin  = args.residual->view_src ? args.residual->view_src : args.residual;
+        const ggml_tensor * rout = args.out_res->view_src  ? args.out_res->view_src  : args.out_res;
