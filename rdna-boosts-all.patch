+            const int eff  = wide ? 1 : (tt >= 4 ? 4 : (tt == 2 ? 2 : 1));
+            dim3 tg((T + NWARPS * eff - 1) / (NWARPS * eff));
+            const float * Wf = (const float *) src0->data;
