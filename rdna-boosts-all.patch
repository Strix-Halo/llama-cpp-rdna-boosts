+// wip/moe-expert-cache: deferred promotion, forwarded to each simple device (the routing is shared,
+// each device promotes into its own arena slice).  The consumer alias is refreshed by `take_over`, so
+// promotion passes a null `weight_cpy`.
+static bool ggml_backend_meta_moe_cache_promote(ggml_backend_t backend, const struct ggml_tensor * weight,
+        const struct ggml_tensor * weight_cpy, const int32_t * ids, int64_t n_used, int64_t n_tok,
+        size_t ids_nb0, size_t ids_nb1) {
+    const size_t n_backends = ggml_backend_meta_n_backends(backend);
+    // `weight == nullptr` is the end-of-pass flush for the batched device-side admission policy: one
+    // call per simple backend, which runs its own per-device policy kernel.
+    if (weight == nullptr) {
+        bool all = true;
+        for (size_t j = 0; j < n_backends; j++) {
+            ggml_backend_t simple_backend = ggml_backend_meta_simple_backend(backend, j);
+            if (simple_backend->iface.moe_cache_promote == nullptr) {
+                continue;
+            }
+            all = all && simple_backend->iface.moe_cache_promote(simple_backend, nullptr, nullptr,
+                                                                 nullptr, 0, 0, 0, 0);
+        }
+        return all;
+    }
+    if (weight_cpy == nullptr) {
+        return false;
+    }
+    if (!ggml_backend_buffer_is_meta(weight_cpy->buffer)) {
+        return false;
+    }
+    bool all = true;
+    for (size_t j = 0; j < n_backends; j++) {
+        ggml_backend_t simple_backend = ggml_backend_meta_simple_backend(backend, j);
+        if (simple_backend->iface.moe_cache_promote == nullptr) {
+            all = false;
+            break;
+        }
+        all = all && simple_backend->iface.moe_cache_promote(simple_backend, weight, nullptr,
+                                                             ids, n_used, n_tok, ids_nb0, ids_nb1);
+    }
+    return all;
+}
