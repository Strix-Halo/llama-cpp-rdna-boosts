+    auto store_lds_a = [&](int ksh, const int abo) {
+#pragma unroll
+        for (int i = 0; i < A_ITEMS; ++i) { const int row = SPLIT_A ? (tid % BM) : (tid + i * MMB_NT); if (row < BM) {
