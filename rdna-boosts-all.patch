+    const int cm = lane & 15, cn = lane >> 4; const int ch = e0 + wm * 16 + cm;
+#pragma unroll
+    for (int j = 0; j < 2; ++j) {
+#pragma unroll
+        for (int e = 0; e < 8; ++e) {
+            const int t = t0 + wn * 32 + j * 16 + MMB_ACC_M(e, cn);
+            if (t >= T) continue;
