+        for (int i = 0; i < B_ITEMS; ++i) { const int c = tid + i * MMB_NT; *(uint4 *)(Bs + (bbo + (c >> 3)) * MMB_LDS_STRIDE + (c & 7) * 8) = bst[i]; }
