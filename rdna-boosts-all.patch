+template <int HC>
+__global__ void __launch_bounds__(MMB_NT, 2)
+hc_gate_mix_kernel(const uint8_t * __restrict__ W, const uint16_t * __restrict__ Lo, const uint16_t * __restrict__ Xn, float * __restrict__ Out,
