+    GGML_ASSERT(src0_alpha->ne[0] == src0_beta->ne[0] && src0_alpha->ne[1] == src0_beta->ne[1]);
+    GGML_ASSERT(ggml_nelements(dst_gate) == ggml_nelements(dst_beta));
