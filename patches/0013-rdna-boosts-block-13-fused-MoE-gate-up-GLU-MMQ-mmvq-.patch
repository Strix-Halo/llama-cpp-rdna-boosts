+#if defined(__HIP_PLATFORM_AMD__)
+static __device__ __forceinline__ float mmvq_hc_mul_rn(const float a, const float b) {
+    float result;
+    asm("v_mul_f32_e32 %0, %1, %2" : "=v"(result) : "v"(a), "v"(b));
