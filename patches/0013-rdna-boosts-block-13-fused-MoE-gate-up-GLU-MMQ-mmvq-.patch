+template <int n_expert_used>
+__launch_bounds__(32, 8)
+static __global__ void mul_mat_id_iq4_nl_weighted_rdna3_5(
+        const void * vx_ptr, const block_q8_1 * y, const int32_t * ids, const float * weights, float * dst,
