+    }
+    static int64_t calibrated = -1;
+    if (calibrated < 0) {
+        float bw = 0.0f;
+        for (int b = 0; b < sched->n_backends; b++) {
+            if (sched->backends[b]->iface.stage_h2d_gbps != NULL) {
+                bw = sched->backends[b]->iface.stage_h2d_gbps(sched->backends[b]);
+                break;
+            }
