+// GGML_SCHED_STAGE_MIN_TOKENS overrides it (0 = stage for every batch).
+static int64_t sched_stage_min_tokens(ggml_backend_sched_t sched) {
+    const char * e = getenv("GGML_SCHED_STAGE_MIN_TOKENS");
+    if (e != nullptr) {
