From 928c61e1df2ed2792f0690e1632922505b884e38 Mon Sep 17 00:00:00 2001
From: Stew Forster <ci@rdna-boosts.invalid>
Date: Wed, 30 Sep 2026 13:13:26 -0500
Subject: [PATCH] wip/issue72: classify GDN state_predelta split copies as
 head-split (AXIS_2)

Candidate fix for the meta-backend GGML_ASSERT in handle_gated_delta_net when
per-slot ctx exceeds native ctx. A scheduler-created split copy of the GDN
recurrent state (Meta(...)#state_predelta-<il>#<c>) reaches the meta policy by
name, matches no model tensor, and defaults to MIRRORED, which has no arm next
to the AXIS_1 q/k/v/g/beta. Classify the copy as the same head split (axis 2)
as the cache_s it derives from.

Not yet validated: the reporter's multi-split case does not reproduce on the
89GB IQ4_XS model here (more per-device headroom than the 97.7GB reporter
model). Normal single-split behavior is unchanged (4B -sm tensor coherence).
---
 src/llama-model.cpp | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 1d43f11cf..ee5dfd23d 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -442,6 +442,7 @@ struct ggml_backend_meta_split_state llama_meta_device_get_split_state(const str
     static const std::regex pattern_ssm_beta        ("blk\\.\\d*\\.ssm_beta.weight");
     static const std::regex pattern_ssm_beta_alpha  ("blk\\.\\d*\\.ssm_ba.weight");
     static const std::regex pattern_r_cache         ("cache_r_l\\d*");
+    static const std::regex pattern_state_predelta  ("state_predelta-\\d+");
     static const std::regex pattern_ple_r_cache     ("cache_ple_r_l\\d*");
     static const std::regex pattern_s_cache         ("cache_s_l\\d*");
     static const std::regex pattern_ssm_conv1d      ("blk\\.\\d*\\.ssm_conv1d.weight");
@@ -500,6 +501,12 @@ struct ggml_backend_meta_split_state llama_meta_device_get_split_state(const str
             il = std::stoull(tensor_name.substr(layer_index_start + 2));
             prefix = "blk." + std::to_string(il) + ".";
             rotation = get_il_eff(il) % ud->n_devices;
+        } else if (tensor_name.substr(0, 15) == "state_predelta-") {
+            // GDN recurrent-state scheduler split copy (`Meta(...)#state_predelta-<il>#<c>`):
+            // keep the layer index and rotation so the head split matches the `cache_s_l<il>` it
+            // derives from (see the get_tensor_config branch below).
+            il = std::stoull(tensor_name.substr(15));
+            rotation = get_il_eff(il) % ud->n_devices;
         } else {
             il = 0;
             rotation = hparams.n_layer() % ud->n_devices;
@@ -597,6 +604,16 @@ struct ggml_backend_meta_split_state llama_meta_device_get_split_state(const str
             }
             return get_tensor_config_impl(GGML_BACKEND_SPLIT_AXIS_0, "ssm_out.weight");
         }
+        if (std::regex_match(tensor_name, pattern_state_predelta)) {
+            // GDN recurrent state (src[5] of GGML_OP_GATED_DELTA_NET).  The non-copy tensor is a
+            // computed activation, so its split state is derived from `cache_s` (AXIS_2 on the 4-D
+            // [S_v, S_v, H, n_seqs] reshape).  A scheduler-created split copy of it reaches the
+            // meta policy by NAME, matches no model tensor, and would default to MIRRORED, which
+            // trips handle_gated_delta_net (AXIS_1 q/k/v/g/beta + MIRRORED state has no arm).
+            // Classify the copy as the same head split (axis 2) so the state stays consistent with
+            // the AXIS_1 inputs.  `state_predelta-<il>` carries the layer index in its name.
+            return get_tensor_config_impl(GGML_BACKEND_SPLIT_AXIS_2);
+        }
         if (std::regex_match(tensor_name, pattern_ssm_conv1d)) {
             return get_tensor_config_impl(GGML_BACKEND_SPLIT_AXIS_1, "ssm_out.weight");
         }
