From 12ed295695939be114f8ea8e4f33fd3d7efa8cae Mon Sep 17 00:00:00 2001
From: briansp2020 <bsp2020@gmail.com>
Date: Wed, 7 Oct 2026 07:53:38 +0000
Subject: [PATCH 4/4] cuda: fold the GDN beta sigmoid into the sequential
 gated_delta_net kernel (bit-identical)

The qwen4exp linear-attention layers compute beta = sigmoid(ssm_beta x) as
a separate UNARY node right before GATED_DELTA_NET (the Q8_0-only
ssm_gate_beta fusion does not apply to BF16 alpha/beta weights).  For the
decode/verify band (one sequence, <= 16 tokens, which never takes the
chunked kernels) the sequential kernel now loads the pre-sigmoid beta and
applies the same 1 / (1 + expf(-x)) as op_sigmoid; the GDN -> cpy cache
fusion is kept.  View/no-op nodes that do not read the sigmoid (the state
reshape) may sit between the two.

Server (2 x R9700, -sm tensor, MTP n-max 3, 2 rounds): greedy 123.7/123.9 ->
124.5/123.9 t/s, chat sequence +0.1/+0.6 %, same greedy output.
GGML_CUDA_FUSE_GDN_BETA_SIGMOID=0 disables it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/gated_delta_net.cu  | 41 ++++++++++++++++++--------
 ggml/src/ggml-cuda/gated_delta_net.cuh |  4 +++
 ggml/src/ggml-cuda/ggml-cuda.cu        | 23 +++++++++++++++
 3 files changed, 55 insertions(+), 13 deletions(-)

diff --git a/ggml/src/ggml-cuda/gated_delta_net.cu b/ggml/src/ggml-cuda/gated_delta_net.cu
index 0fd542051..b23bf227c 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cu
+++ b/ggml/src/ggml-cuda/gated_delta_net.cu
@@ -28,7 +28,8 @@ gated_delta_net_cuda(const float * q,
                                      const uint3   rq3_magic,
                                      float         scale,
                                      int64_t       state_slot_stride,
-                                     int           K) {
+                                     int           K,
+                                     int           beta_sigmoid) {
     const uint32_t h_idx    = blockIdx.x;
     const uint32_t sequence = blockIdx.y;
     // each warp owns one column, using warp-level primitives to reduce across rows
@@ -70,7 +71,9 @@ gated_delta_net_cuda(const float * q,
         const float * beta_t = beta + gb_offset;
         const float * g_t    = g    + gb_offset * (KDA ? S_v : 1);
 
-        const float beta_val = *beta_t;
+        // beta_sigmoid: beta is the pre-sigmoid value (the UNARY(sigmoid) node was fused in); same expression as
+        // unary.cu op_sigmoid
+        const float beta_val = beta_sigmoid ? 1.0f / (1.0f + expf(-*beta_t)) : *beta_t;
 
         // Cache k and q in registers
         float k_reg[rows_per_lane];
@@ -177,7 +180,7 @@ static void launch_gated_delta_net(
         int64_t sv1,   int64_t sv2, int64_t sv3,
         int64_t sb1,   int64_t sb2, int64_t sb3,
         int64_t neqk1, int64_t rq3,
-        float scale, int64_t state_slot_stride, int K, cudaStream_t stream) {
+        float scale, int64_t state_slot_stride, int K, int beta_sigmoid, cudaStream_t stream) {
     //TODO: Add chunked kernel for even faster pre-fill
     const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
     const int num_warps = 4;
@@ -193,26 +196,26 @@ static void launch_gated_delta_net(
             ggml_cuda_kernel_launch(gated_delta_net_cuda<16, KDA, keep_rs_t>, launch_params,
                 q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
-                sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
+                sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K, beta_sigmoid);
             break;
         case 32:
             ggml_cuda_kernel_launch(gated_delta_net_cuda<32, KDA, keep_rs_t>, launch_params,
                 q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
-                sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
+                sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K, beta_sigmoid);
             break;
         case 64: {
             ggml_cuda_kernel_launch(gated_delta_net_cuda<64, KDA, keep_rs_t>, launch_params,
                 q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
-                sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
+                sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K, beta_sigmoid);
             break;
         }
         case 128: {
             ggml_cuda_kernel_launch(gated_delta_net_cuda<128, KDA, keep_rs_t>, launch_params,
                 q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
-                sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
+                sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K, beta_sigmoid);
             break;
         }
         default:
@@ -222,7 +225,8 @@ static void launch_gated_delta_net(
 }
 
 static void ggml_cuda_op_gated_delta_net_impl(
-        ggml_backend_cuda_context & ctx, ggml_tensor * dst, const ggml_cuda_gated_delta_net_fused_cache * cache) {
+        ggml_backend_cuda_context & ctx, ggml_tensor * dst, const ggml_cuda_gated_delta_net_fused_cache * cache,
+        const ggml_tensor * beta_presig = nullptr) {
     ggml_tensor * src_q     = dst->src[0];
     ggml_tensor * src_k     = dst->src[1];
     ggml_tensor * src_v     = dst->src[2];
@@ -254,7 +258,13 @@ static void ggml_cuda_op_gated_delta_net_impl(
     const float * k_d = (const float *) src_k->data;
     const float * v_d = (const float *) src_v->data;
     const float * g_d = (const float *) src_g->data;
-    const float * b_d = (const float *) src_beta->data;
+    // beta_presig: the input of a fused UNARY(sigmoid) beta node (contiguous, same element order as the contiguous beta,
+    // so beta's strides index it); the sequential kernel applies the
+    // sigmoid.  Only the decode/verify band uses it (n_seqs == 1, n_tokens <= 16 never takes the chunked path below).
+    const int     beta_sigmoid = beta_presig != nullptr;
+    const float * b_d = (const float *) (beta_presig ? beta_presig->data : src_beta->data);
+    GGML_ASSERT(!beta_sigmoid || (n_seqs == 1 && n_tokens <= 16 && ggml_is_contiguous(beta_presig) &&
+                                  ggml_nelements(beta_presig) == ggml_nelements(src_beta)));
 
     const float * s_d   = (const float *) src_state->data;
     float *       dst_d = (float *) dst->data;
@@ -392,21 +402,21 @@ static void ggml_cuda_op_gated_delta_net_impl(
         if (keep_rs) {
             launch_gated_delta_net<true, true>(q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d,
                 S_v, H, n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
-                sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, stream);
+                sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, beta_sigmoid, stream);
         } else {
             launch_gated_delta_net<true, false>(q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d,
                 S_v, H, n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
-                sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, stream);
+                sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, beta_sigmoid, stream);
         }
     } else {
         if (keep_rs) {
             launch_gated_delta_net<false, true>(q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d,
                 S_v, H, n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
-                sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, stream);
+                sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, beta_sigmoid, stream);
         } else {
             launch_gated_delta_net<false, false>(q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d,
                 S_v, H, n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
-                sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, stream);
+                sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, beta_sigmoid, stream);
         }
     }
 }
@@ -419,3 +429,8 @@ void ggml_cuda_op_gated_delta_net_fused_cache(
         ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_cuda_gated_delta_net_fused_cache cache) {
     ggml_cuda_op_gated_delta_net_impl(ctx, dst, &cache);
 }
+
+void ggml_cuda_op_gated_delta_net_beta_sigmoid(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const ggml_tensor * beta_presig,
+                                               const ggml_cuda_gated_delta_net_fused_cache * cache) {
+    ggml_cuda_op_gated_delta_net_impl(ctx, dst, cache, beta_presig);
+}
diff --git a/ggml/src/ggml-cuda/gated_delta_net.cuh b/ggml/src/ggml-cuda/gated_delta_net.cuh
index f9bf43706..83732b213 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cuh
+++ b/ggml/src/ggml-cuda/gated_delta_net.cuh
@@ -12,3 +12,7 @@ void ggml_cuda_op_gated_delta_net(ggml_backend_cuda_context & ctx, ggml_tensor *
 // same op, but writes the snapshot(s) into the cache instead of dst (see ggml_cuda_try_gdn_cache_fusion)
 void ggml_cuda_op_gated_delta_net_fused_cache(ggml_backend_cuda_context & ctx, ggml_tensor * dst,
                                               ggml_cuda_gated_delta_net_fused_cache cache);
+
+// same op with the beta UNARY(sigmoid) fused in: beta_presig is the sigmoid's input (decode/verify band only)
+void ggml_cuda_op_gated_delta_net_beta_sigmoid(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const ggml_tensor * beta_presig,
+                                               const ggml_cuda_gated_delta_net_fused_cache * cache);
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 2bfa9b204..f4e3671dc 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5898,6 +5898,29 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
 
     // gated_delta_net -> cpy: scatter recurrent-state snapshots into the cache
     static const bool disable_gdn_cpy = getenv("GGML_CUDA_DISABLE_GDN_CPY") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_GDN_CPY"));
+
+    // UNARY(sigmoid) beta -> GATED_DELTA_NET (GGML_CUDA_FUSE_GDN_BETA_SIGMOID=0: off): the sequential GDN kernel applies the
+    // sigmoid to the beta it loads.  Decode/verify band only (single sequence, <= 16 tokens: never the chunked kernels).
+    static const bool fuse_gdn_beta_sig = getenv("GGML_CUDA_FUSE_GDN_BETA_SIGMOID") == nullptr || atoi(getenv("GGML_CUDA_FUSE_GDN_BETA_SIGMOID")) != 0;
+    if (fuse_gdn_beta_sig && node->op == GGML_OP_UNARY && ggml_get_unary_op(node) == GGML_UNARY_OP_SIGMOID &&
+            node->type == GGML_TYPE_F32 && node->src[0]->type == GGML_TYPE_F32 && ggml_is_contiguous(node) &&
+            ggml_is_contiguous(node->src[0]) && ggml_are_same_shape(node, node->src[0])) {
+        // view/no-op nodes that do not read the sigmoid may sit between it and the GDN (the state reshape does)
+        int j = i + 1;
+        while (j < cgraph->n_nodes && j <= i + 4 && ggml_cuda_is_view_or_noop(cgraph->nodes[j]) &&
+               cgraph->nodes[j]->src[0] != node && cgraph->nodes[j]->view_src != node) {
+            ++j;
+        }
+        if (j < cgraph->n_nodes && cgraph->nodes[j]->op == GGML_OP_GATED_DELTA_NET && cgraph->nodes[j]->src[4] == node &&
+                cgraph->nodes[j]->src[2]->ne[2] <= 16 && cgraph->nodes[j]->src[2]->ne[3] == 1 &&
+                ggml_node_get_use_count(cgraph, i) == 1 && !(node->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            ggml_tensor * gdn = cgraph->nodes[j];
+            ggml_cuda_gated_delta_net_fused_cache fused_state_cpy;
+            const int nodes_to_skip = disable_gdn_cpy ? 0 : ggml_cuda_try_gdn_cache_fusion(cgraph, j, fused_state_cpy);
+            ggml_cuda_op_gated_delta_net_beta_sigmoid(*cuda_ctx, gdn, node->src[0], nodes_to_skip > 0 ? &fused_state_cpy : nullptr);
+            return (j - i) + nodes_to_skip;
+        }
+    }
     if (!disable_gdn_cpy && node->op == GGML_OP_GATED_DELTA_NET) {
         ggml_cuda_gated_delta_net_fused_cache fused_state_cpy;
         const int nodes_to_skip = ggml_cuda_try_gdn_cache_fusion(cgraph, i, fused_state_cpy);
