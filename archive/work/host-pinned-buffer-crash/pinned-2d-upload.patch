diff --git a/common/common.cpp b/common/common.cpp
index d8677545d..35a49f53f 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1251,6 +1251,26 @@ common_init_result::common_init_result(common_params & params, bool model_only)
             params.verbosity >= LOG_LEVEL_DEBUG ? GGML_LOG_LEVEL_DEBUG : GGML_LOG_LEVEL_ERROR);
     }
 
+    // wip/host-pinned-buffer-crash: `--load-mode none` + `-sm tensor` + host-resident experts puts the
+    // host expert/master tensors in a pageable CPU buffer (CPU_REPACK / CPU), while `-sm layer` keeps
+    // them in the pinned ROCm_Host buffer.  The `-sm tensor` split upload can then fault intermittently
+    // (a GPU access to a non-resident host page at load); the default `--load-mode auto`/`mmap` and
+    // `-sm layer` are both stable.  Warn rather than reject.
+    if (params.load_mode == LLAMA_LOAD_MODE_NONE && params.split_mode == LLAMA_SPLIT_MODE_TENSOR) {
+        bool host_experts = false;
+        for (const auto & o : params.tensor_buft_overrides) {
+            if (o.buft == ggml_backend_cpu_buffer_type()) {
+                host_experts = true;
+                break;
+            }
+        }
+        if (host_experts) {
+            COM_WRN("%s: --load-mode none with -sm tensor and host-resident experts (-ncmoe/--cpu-moe) is "
+                    "known to fault intermittently during the split upload; use the default --load-mode "
+                    "auto (or mmap), or -sm layer\n", __func__);
+        }
+    }
+
     llama_model * model = llama_model_load_from_file(params.model.path.c_str(), mparams);
     if (model == NULL) {
         return;
