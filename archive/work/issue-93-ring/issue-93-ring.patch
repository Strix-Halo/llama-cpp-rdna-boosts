+    auto bound_fn = (size_t (*)(ggml_backend_t, size_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_h2d_stage_bound");
+    return bound_fn != nullptr ? bound_fn(backend, max_table) : 0;
