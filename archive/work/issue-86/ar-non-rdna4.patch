diff --git a/ggml/src/ggml-cuda/allreduce-hip.cu b/ggml/src/ggml-cuda/allreduce-hip.cu
index e46b4ab8c..3ab930b53 100644
--- a/ggml/src/ggml-cuda/allreduce-hip.cu
+++ b/ggml/src/ggml-cuda/allreduce-hip.cu
@@ -744,6 +744,12 @@ ggml_cuda_ar_pipeline * ggml_cuda_ar_pipeline_init(const int * devices, size_t n
     // RDNA4 (gfx1200/gfx1201).  On any other architecture the pipeline is
     // not created and the allreduce dispatch falls back to the default
     // (RCCL) path, until community verification exists (e.g. RDNA3 pairs).
+    //
+    // GGML_CUDA_AR_ALLOW_NON_RDNA4=1 opts into the unverified path on other
+    // architectures (e.g. gfx1100 / RDNA3), where the host-staged pipeline is
+    // the working alternative to RCCL on a PCIe root port without AtomicOp
+    // completer support (ROCm/ROCm#6520).  See wip/ar-non-rdna4/.
+    const bool allow_non_rdna4 = ggml_cuda_ar_env_u64("GGML_CUDA_AR_ALLOW_NON_RDNA4", 0) != 0;
     for (size_t i = 0; i < n_devices; ++i) {
         hipDeviceProp_t prop;
         ggml_cuda_set_device(devices[i]);
@@ -755,12 +761,18 @@ ggml_cuda_ar_pipeline * ggml_cuda_ar_pipeline_init(const int * devices, size_t n
         const char * arch = prop.gcnArchName;   // e.g. "gfx1201:xnack-"
         const bool rdna4  = strncmp(arch, "gfx1200", 7) == 0 ||
                             strncmp(arch, "gfx1201", 7) == 0;
-        if (!rdna4) {
+        if (!rdna4 && !allow_non_rdna4) {
             GGML_LOG_WARN("%s: internal all-reduce is RDNA4-only (gfx1200/gfx1201); "
-                          "device %d reports %s -- falling back to the default path\n",
+                          "device %d reports %s -- falling back to the default path "
+                          "(set GGML_CUDA_AR_ALLOW_NON_RDNA4=1 to override)\n",
                           __func__, devices[i], arch);
             return nullptr;
         }
+        if (!rdna4) {
+            GGML_LOG_WARN("%s: internal all-reduce is UNVERIFIED on %s; "
+                          "GGML_CUDA_AR_ALLOW_NON_RDNA4=1 -- proceeding anyway\n",
+                          __func__, arch);
+        }
     }
 
     auto * p = new ggml_cuda_ar_pipeline{};
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index d599cef85..45e578ef9 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -1728,7 +1728,18 @@ static bool ggml_backend_cuda_comm_allreduce_tensor(void * comm_ctx_v, struct gg
     if (comm_ctx->ar_pipeline != nullptr && ggml_backend_cuda_comm_is_small(ne, n_backends)) {
         return ggml_backend_cuda_comm_try_allreduce_internal(comm_ctx, tensors);
     }
-    return comm_ctx->try_allreduce(comm_ctx, tensors);
+    auto fn = comm_ctx->try_allreduce;
+    const bool ok = fn(comm_ctx, tensors);
+    if (!ok && comm_ctx->ar_pipeline != nullptr &&
+        fn != ggml_backend_cuda_comm_try_allreduce_internal) {
+        // The call that just failed was not the internal pipeline, i.e. NCCL
+        // died mid-call and re-routed try_allreduce to internal.  Serve this
+        // same call through the internal pipeline instead of returning false
+        // and letting the meta backend's butterfly run -- on a RCCL-broken
+        // host the butterfly is what hangs (issue #86).
+        return ggml_backend_cuda_comm_try_allreduce_internal(comm_ctx, tensors);
+    }
+    return ok;
 }
 
