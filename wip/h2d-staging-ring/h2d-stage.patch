+        // MUL_MAT_ID: src[2] is the router's expert ids, ne[1] is the token count
+        return node->src[2]->ne[1];
+    }
+    if (node->src[1] != NULL) {
+        return node->src[1]->ne[1];
+    }
+    return 0;
