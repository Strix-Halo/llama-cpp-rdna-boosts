+        chunk.device  = j;
+        chunk.slot    = slot_ptr;
+        chunk.size    = chunk_size_j;
+        chunk.src     = mirrored ? 0 : offset_j;
+        entry.chunks.push_back(chunk);
+        if (!mirrored) {
+            offset_j += chunk_size_j;
+        }
+    }
+    if (entry.chunks.empty() || (!mirrored && offset_j != size)) {
+        return false;
+    }
