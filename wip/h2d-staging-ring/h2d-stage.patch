     }
 
+    // Op-offload H2D staging ring (issue #50 WIP).  Whole-tensor host->device uploads of offloaded
+    // weights are issued on a dedicated copy stream (stream 1) into a small ring of device slots, so
+    // the upload of one split overlaps the compute of the previous one.  stage_buffer grows a slot on
+    // demand and returns null on allocation failure (the caller then falls back to the in-order path).
+    static constexpr int H2D_STAGE_SLOTS = 4;
+    void * h2d_stage[H2D_STAGE_SLOTS]      = {};
+    size_t h2d_stage_size[H2D_STAGE_SLOTS] = {};
+    size_t h2d_stage_total                 = 0;
+
+    // Total device budget for the staging ring, GGML_SCHED_STAGE_MAX_MB MiB (default 1024).  A growth
+    // that would exceed it returns null and the caller falls back to the in-order copy path, so the
+    // feature can never turn a load into an OOM (block-15 arena precedent).
+    static size_t h2d_stage_budget() {
+        static const size_t budget = []() {
+            const char * e = getenv("GGML_SCHED_STAGE_MAX_MB");
+            const long mb = e ? atol(e) : 1024;
+            return mb > 0 ? (size_t) mb * 1024 * 1024 : (size_t) 0;
+        }();
+        return budget;
+    }
+
+    void * h2d_stage_buffer(int slot, size_t size) {
+        GGML_ASSERT(slot >= 0 && slot < H2D_STAGE_SLOTS);
+        if (size > h2d_stage_size[slot]) {
+            const size_t old_size = h2d_stage_size[slot];
+            const size_t new_size = size + size/4 + (1u << 20);
+            if (h2d_stage_total - old_size + new_size > h2d_stage_budget()) {
+                return nullptr;
+            }
+            if (h2d_stage[slot] != nullptr) {
+                cudaFree(h2d_stage[slot]);
+                h2d_stage[slot]      = nullptr;
+                h2d_stage_size[slot] = 0;
+            }
+            void * p = nullptr;
+            if (cudaMalloc(&p, new_size) != cudaSuccess) {
+                cudaGetLastError();
+                return nullptr;
+            }
+            h2d_stage[slot]      = p;
+            h2d_stage_size[slot] = new_size;
+            h2d_stage_total += new_size - old_size;
+        }
+        return h2d_stage[slot];
+    }
+
+    void h2d_stage_free() {
+        for (int s = 0; s < H2D_STAGE_SLOTS; ++s) {
+            if (h2d_stage[s] != nullptr) {
+                cudaFree(h2d_stage[s]);
+                h2d_stage[s]      = nullptr;
+                h2d_stage_size[s] = 0;
+            }
+        }
+        h2d_stage_total = 0;
+    }
+
+    cudaStream_t copy_stream() { return stream(device, 1); }
+
+    // One-off H2D bandwidth measurement (issue #50 WIP), used to pick the staging gate: a narrow link
+    // needs a wider batch before the whole-tensor upload pays off.  Cached for the context.
+    float h2d_gbps = -1.0f;
+
+    float h2d_gbps_measure() {
+#if defined(__CUDA_ARCH__)
+        return 0.0f; // device pass: the host event API is not available
+#else
+        if (h2d_gbps >= 0.0f) {
+            return h2d_gbps;
+        }
+        const size_t sz = 512u << 20; // past the Infinity Cache (a 64 MiB probe over-measures)
+        void * h = malloc(sz);
+        void * d = nullptr;
+        if (h == nullptr || cudaMalloc(&d, sz) != cudaSuccess) {
+            cudaGetLastError();
+            if (d != nullptr) cudaFree(d);
+            free(h);
+            h2d_gbps = 0.0f;
+            return h2d_gbps;
+        }
+        memset(h, 1, sz);
+        cudaEvent_t a = nullptr, b = nullptr;
+        if (cudaEventCreate(&a) != cudaSuccess || cudaEventCreate(&b) != cudaSuccess) {
+            cudaGetLastError();
+            if (a) cudaEventDestroy(a);
+            if (b) cudaEventDestroy(b);
+            cudaFree(d);
+            free(h);
+            h2d_gbps = 0.0f;
+            return h2d_gbps;
+        }
+        cudaMemcpy(d, h, sz, cudaMemcpyHostToDevice); // warmup + fault the pages
+        cudaDeviceSynchronize();
+        cudaEventRecord(a, copy_stream());
+        for (int i = 0; i < 3; ++i) {
+            cudaMemcpyAsync(d, h, sz, cudaMemcpyHostToDevice, copy_stream());
+        }
+        cudaEventRecord(b, copy_stream());
+        cudaEventSynchronize(b);
+        float ms = 0.0f;
+        cudaEventElapsedTime(&ms, a, b);
+        h2d_gbps = ms > 0.0f ? float(3.0*double(sz)/1e9 / (double(ms)/1000.0)) : 0.0f;
+        cudaEventDestroy(a);
+        cudaEventDestroy(b);
+        cudaFree(d);
+        free(h);
+        GGML_LOG_INFO("%s: H2D staging calibration: %.1f GB/s\n", name.c_str(), double(h2d_gbps));
+        fprintf(stderr, "[H2DCAL] %s: sz=%zu MiB x3, %.2f ms -> %.1f GB/s\n", name.c_str(), sz >> 20, double(ms), double(h2d_gbps));
+        return h2d_gbps;
+#endif
+    }
+
     ~ggml_backend_cuda_context();
 
