+        ggml_tensor * moe_cpu_ids = ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, moe_cpu_n, n_tokens);
+        ggml_set_input(moe_cpu_ids);
+        cb(moe_cpu_ids, "ffn_moe_cpu_ids", il);
+        ggml_tensor * moe_cpu_gate = ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, 1, 1, n_tokens);
+        ggml_set_input(moe_cpu_gate);
+        cb(moe_cpu_gate, "ffn_moe_cpu_gate", il);
+
+        ggml_tensor * cpu_act = nullptr;
+        if (gate_up_exps != nullptr) {
+            ggml_tensor * gu = ggml_mul_mat_id(ctx0, gate_up_exps, moe_cpu_cur, moe_cpu_ids);
+            ggml_backend_sched_set_tensor_backend(sched, gu, backend_cpu);
+            cb(gu, "ffn_moe_gate_up_cpu", il);
+            const int64_t n_ff = gu->ne[0] / 2;
+            ggml_tensor * cg  = ggml_view_3d(ctx0, gu, n_ff, gu->ne[1], gu->ne[2], gu->nb[1], gu->nb[2], 0);
+            ggml_tensor * cu  = ggml_view_3d(ctx0, gu, n_ff, gu->ne[1], gu->ne[2], gu->nb[1], gu->nb[2], n_ff * gu->nb[0]);
+            cpu_act = ggml_swiglu_split(ctx0, cg, cu);
+        } else {
+            ggml_tensor * cu = ggml_mul_mat_id(ctx0, up_exps, moe_cpu_cur, moe_cpu_ids);
+            ggml_backend_sched_set_tensor_backend(sched, cu, backend_cpu);
+            cb(cu, "ffn_moe_up_cpu", il);
+            if (gate_exps != nullptr) {
+                ggml_tensor * cg = ggml_mul_mat_id(ctx0, gate_exps, moe_cpu_cur, moe_cpu_ids);
+                ggml_backend_sched_set_tensor_backend(sched, cg, backend_cpu);
+                cb(cg, "ffn_moe_gate_cpu", il);
+                cpu_act = ggml_swiglu_split(ctx0, cg, cu);
+            } else {
+                cpu_act = ggml_silu(ctx0, cu);
+            }
+        }
+        cb(cpu_act, "ffn_moe_swiglu_cpu", il);
+
+        ggml_tensor * cpu_down = ggml_mul_mat_id(ctx0, down_exps, cpu_act, moe_cpu_ids);
+        ggml_backend_sched_set_tensor_backend(sched, cpu_down, backend_cpu);
+        cb(cpu_down, "ffn_moe_down_cpu", il);
+
+        // the weights are derived from the ids (exactly as on the GPU branch), so the CPU branch needs
+        // no weight plumbing - only the SAME global normalisation and the per-token gate.
+        ggml_tensor * cpu_w = ggml_get_rows(ctx0, probs, moe_cpu_ids); // [1, n_cpu, n_tokens]
+        if (norm_w && moe_w_sum != nullptr) {
+            // mirror the GPU branch's 2-D normalisation exactly (including its broadcast form)
+            cpu_w = ggml_reshape_2d(ctx0, cpu_w, moe_cpu_n, n_tokens);
+            cpu_w = ggml_div(ctx0, cpu_w, moe_w_sum);
+            cpu_w = ggml_reshape_3d(ctx0, cpu_w, 1, moe_cpu_n, n_tokens);
+        }
+        if (w_scale != 0.0f && w_scale != 1.0f) {
+            cpu_w = ggml_scale(ctx0, cpu_w, w_scale);
+        }
+        cpu_w = ggml_mul(ctx0, cpu_w, moe_cpu_gate); // a gated-off token contributes exactly 0
+        ggml_backend_sched_set_tensor_backend(sched, cpu_w, backend_cpu);
+        cb(cpu_w, "ffn_moe_weights_cpu", il);
+
+        ggml_tensor * cpu_exp = ggml_mul(ctx0, cpu_down, cpu_w); // [n_embd, n_cpu, n_tokens]
+
+        ggml_build_forward_expand(gf, cpu_exp);
+        std::vector<ggml_tensor *> cpu_views((size_t) moe_cpu_n, nullptr);
+        for (int i = 0; i < moe_cpu_n; ++i) {
+            cpu_views[i] = ggml_view_2d(ctx0, cpu_exp, n_embd, n_tokens, cpu_exp->nb[2], (size_t) i * cpu_exp->nb[1]);
+            ggml_build_forward_expand(gf, cpu_views[i]);
+        }
+        ggml_tensor * cpu_out = cpu_views[0];
+        for (int i = 1; i < moe_cpu_n; ++i) {
+            cpu_out = ggml_add(ctx0, cpu_out, cpu_views[i]);
+            ggml_build_forward_expand(gf, cpu_out);
+        }
+        if (moe_cpu_n == 1) {
+            cpu_out = ggml_cont(ctx0, cpu_out);
+        }
+        ggml_backend_sched_set_tensor_backend(sched, cpu_out, backend_cpu);
+        cb(cpu_out, "ffn_moe_out_cpu", il);
+
+        ggml_backend_sched_set_moe_cpu_split(sched, selected_experts, moe_cpu_ids, moe_cpu_gate);
+
+        moe_out = ggml_add(ctx0, moe_out, cpu_out);
+        cb(moe_out, "ffn_moe_out_split", il);
+    }
+
     cb(moe_out, "ffn_moe_out", il);
 
     return moe_out;
