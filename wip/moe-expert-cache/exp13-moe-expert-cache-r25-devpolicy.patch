         ggml_tensor * repeated = ggml_repeat_4d(ctx0, cur, n_embd, n_expert_used, n_tokens, 1);
@@ -2437,6 +2492,86 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         moe_out = ggml_cont(ctx0, moe_out);
     }
 
+    if (moe_cpu_on) {
+        // Both inputs are host-written graph inputs - `GGML_TENSOR_FLAG_INPUT` puts them on the last
+        // (CPU) backend by construction, and the scheduler's expert hook publishes the partition into
