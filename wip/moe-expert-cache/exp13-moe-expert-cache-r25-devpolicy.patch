+        type_op == LLM_FFN_SILU &&
+        gating_op != LLAMA_EXPERT_GATING_FUNC_TYPE_SOFTMAX_WEIGHT &&
+        down_exps != nullptr && moe_cpu_w != nullptr && moe_cpu_w->buffer != nullptr &&
+        up_exps_b == nullptr && gate_exps_b == nullptr && gate_up_exps_b == nullptr && down_exps_b == nullptr &&
+        up_exps_s == nullptr && gate_exps_s == nullptr && down_exps_s == nullptr &&
+        ggml_backend_buffer_is_host(moe_cpu_w->buffer) &&
+        ggml_backend_buffer_get_type(moe_cpu_w->buffer) != ggml_backend_cpu_buffer_type();
+    if (moe_cpu_on && gate_exps != nullptr && il >= 0 && hparams.swiglu_clamp_exp[il] > 1e-6f) {
+        moe_cpu_on = false;   // the clamped-swiglu variants are not reproduced in the CPU branch
+    }
+    if (moe_cpu_on) {
+        static bool once = false;
+        if (!once) {
+            once = true;
+            LLAMA_LOG_WARN("build_moe_ffn: CPU SPLIT building branch: n_cpu=%d n_tokens=%lld n_expert_used=%lld il=%d\n",
+                          moe_cpu_n, (long long) n_tokens, (long long) n_expert_used, il);
+        }
+    } else {
+        static bool once_off = false;
+        if (!once_off && moe_cpu_n > 0) {
