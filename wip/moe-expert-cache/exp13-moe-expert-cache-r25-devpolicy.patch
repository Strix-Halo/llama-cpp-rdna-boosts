         weights = ggml_div(ctx0, weights, weights_sum); // [n_expert_used, n_tokens]
         cb(weights, "ffn_moe_weights_norm", il);
@@ -2240,6 +2292,9 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
 
     cur = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
 
+    // wip/moe-expert-cache: the CPU branch's input, captured before the GLU overwrites `cur`
+    ggml_tensor * moe_cpu_cur = moe_cpu_on ? cur : nullptr;
+
     if (weight_before_ffn) {
