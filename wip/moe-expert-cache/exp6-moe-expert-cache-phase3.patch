+            ggml_build_forward_expand(gf, cpu_views[i]);
+        }
+        ggml_tensor * cpu_out = cpu_views[0];
+        for (int i = 1; i < moe_cpu_n; ++i) {
+            cpu_out = ggml_add(ctx0, cpu_out, cpu_views[i]);
+            ggml_build_forward_expand(gf, cpu_out);
+        }
+        if (moe_cpu_n == 1) {
+            cpu_out = ggml_cont(ctx0, cpu_out);
+        }
+        ggml_backend_sched_set_tensor_backend(sched, cpu_out, backend_cpu);
