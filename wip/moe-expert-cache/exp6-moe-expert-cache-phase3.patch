+
+        ggml_backend_sched_set_moe_cpu_split(sched, selected_experts, moe_cpu_ids, moe_cpu_gate);
+
+        moe_out = ggml_add(ctx0, moe_out, cpu_out);
+        cb(moe_out, "ffn_moe_out_split", il);
+    }
+
     cb(moe_out, "ffn_moe_out", il);
 
     return moe_out;
