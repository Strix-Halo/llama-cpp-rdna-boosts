@@ -20,6 +20,7 @@
 
 #include "hc-mix.cuh"
 
+#include "convert.cuh"
 #include "quantize.cuh"
 #include "unary.cuh"
 #include "vecdotq.cuh"
@@ -96,6 +97,11 @@ static __global__ void hc_mix_rms_gamma_quant(
