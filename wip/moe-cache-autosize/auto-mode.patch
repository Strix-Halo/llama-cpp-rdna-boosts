+void llama_model_moe_cache_preflight(const llama_model * model) {
+    if (model == nullptr) {
+        return;
+    }
+    std::map<ggml_backend_dev_t, size_t> host_expert_bytes;
+    for (const auto & [name, t] : model->tensors_by_name) {
+        if (t->buffer == nullptr || name.find("exps") == std::string::npos) {
+            continue;
+        }
+        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(t->buffer);
+        if (!ggml_backend_buft_is_host(buft)) {
+            continue;
+        }
+        host_expert_bytes[ggml_backend_buft_get_device(buft)] += ggml_nbytes(t);
+    }
+    for (const auto & [dev, bytes] : host_expert_bytes) {
+        if (dev != nullptr) {
+            ggml_backend_dev_moe_cache_preflight(dev, bytes);
+        }
+    }
