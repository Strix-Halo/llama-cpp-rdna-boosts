diff --git a/ggml/src/ggml-alloc.c b/ggml/src/ggml-alloc.c
index dbe568686..0571c881d 100644
--- a/ggml/src/ggml-alloc.c
+++ b/ggml/src/ggml-alloc.c
@@ -1033,6 +1033,30 @@ bool ggml_gallocr_reserve_n(ggml_gallocr_t galloc, struct ggml_cgraph * graph, c
     return ggml_gallocr_reserve_n_impl(galloc, graph, node_buffer_ids, leaf_buffer_ids, /*no_alloc =*/ false, NULL);
 }
 
+void ggml_gallocr_drop_buffers(ggml_gallocr_t galloc) {
+    // WIP r42: release every compute buffer so a later reserve can size the layout DOWN, not just up.
+    // Multiple buffer ids can alias one vbuffer when they share a tallocr; free each tallocr once.
+    for (int i = 0; i < galloc->n_buffers; i++) {
+        int shared_with = -1;
+        for (int j = 0; j < i; j++) {
+            if (galloc->buf_tallocs[j] == galloc->buf_tallocs[i]) {
+                shared_with = j;
+                break;
+            }
+        }
+        if (shared_with >= 0) {
+            galloc->buffers[i] = galloc->buffers[shared_with];
+            continue;
+        }
+        if (galloc->buffers[i] != NULL) {
+            ggml_vbuffer_free(galloc->buffers[i]);
+        }
+        galloc->buffers[i] = NULL;
+    }
+    // force the next ggml_gallocr_alloc_graph() to re-reserve from the current graph
+    galloc->layout_valid = false;
+}
+
 bool ggml_gallocr_reserve(ggml_gallocr_t galloc, struct ggml_cgraph *graph) {
     return ggml_gallocr_reserve_n(galloc, graph, NULL, NULL);
 }
