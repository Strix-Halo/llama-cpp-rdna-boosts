+// ---------------------------------------------------------------------------------------------
+// r42 (OPEN 2 / TODO #42): a per-device VMM pool for the COMPUTE buffer.
+//
+// The graph allocator grows the compute buffer with a free-then-allocate-larger, so it needs one block
+// CONTIGUOUS in physical memory that is bigger than the one it just released.  On ROCm the arena's
+// per-table cudaFree()s do not coalesce, so yielding the whole arena (measured: all 288 tables stood
+// down, ~tens of GiB) still leaves the 11763 MiB allocation unsatisfiable -- the free space exists, but
+// never as one block.  VMM removes the contiguity requirement: one VA range is reserved per device up
+// front and physical is mapped into it per allocation, so growing the compute buffer only needs
+// physical pages, which are page-granular.
+//
+// Deliberately HIP-scoped (the env gate returns false elsewhere) and compute-only (the graph allocator
+// is the only caller that knows the usage): model weights stay on cudaMalloc, so no other backend's and
+// no weight allocation's behaviour changes.  Every allocation is mapped and unmapped individually --
+// never a bulk unmap -- which is also what the ROCm workaround in ggml_cuda_pool_vmm needs
+// (ROCm/ROCR-Runtime#285).
+struct ggml_cuda_vmm_pool {
+    bool                     inited      = false;
+    CUdeviceptr              base        = 0;
+    size_t                   size        = 0;
+    size_t                   granularity = 0;
+    std::map<void *, size_t> live;        // allocation -> mapped size
+    std::map<size_t, size_t> free_blocks; // offset -> size, coalesced
+};
+
+// A reservation costs no physical memory; keep it generous but small enough that several devices'
+// reservations coexist comfortably in the 47-bit address space.
+static const size_t GGML_CUDA_VMM_POOL_SIZE = 1ull << 36; // 64 GiB
+
+static std::mutex g_vmm_pool_mutex;
+static ggml_cuda_vmm_pool g_vmm_pools[GGML_CUDA_MAX_DEVICES];
+
+static bool ggml_cuda_compute_vmm_enabled() {
+#if defined(GGML_USE_HIP)
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char * env = getenv("GGML_CUDA_COMPUTE_VMM");
+        enabled = env != NULL ? atoi(env) : 0;
+    }
+    return enabled != 0;
+#else
+    return false;   // RDNA/ROCm-scoped: no other backend's allocation changes
+#endif
+}
+
+static void ggml_cuda_vmm_pool_init_locked(int device, ggml_cuda_vmm_pool & p) {
+    if (p.inited) {
+        return;
+    }
+    p.granularity = ggml_cuda_info().devices[device].vmm_granularity;
+    if (p.granularity == 0) {
+        p.granularity = 2u * 1024 * 1024;
+    }
+    p.size = GGML_CUDA_VMM_POOL_SIZE;
+    ggml_cuda_set_device(device);
+    CU_CHECK(cuMemAddressReserve(&p.base, p.size, p.granularity, 0, 0));
+    p.free_blocks[0] = p.size;
+    p.inited = true;
+    GGML_LOG_INFO("%s: reserved %.2f GiB of VA (granularity %.2f MiB) on device %d for the compute-buffer VMM pool\n",
+                  __func__, p.size / 1024.0 / 1024.0 / 1024.0, p.granularity / 1024.0 / 1024.0, device);
+}
+
+static void * ggml_cuda_vmm_alloc(int device, size_t size) {
+    std::lock_guard<std::mutex> lock(g_vmm_pool_mutex);
+    ggml_cuda_vmm_pool & p = g_vmm_pools[device];
+    ggml_cuda_vmm_pool_init_locked(device, p);
+
+    const size_t aligned = p.granularity * ((size + p.granularity - 1) / p.granularity);
+
+    // pick the first block that fits; leave the free list untouched until the mapping actually succeeds
+    // so a failed (yielded) attempt does not need to be undone
+    auto it = p.free_blocks.end();
+    for (auto cand = p.free_blocks.begin(); cand != p.free_blocks.end(); ++cand) {
+        if (cand->second >= aligned) {
+            it = cand;
+            break;
+        }
+    }
+    if (it == p.free_blocks.end()) {
+        return nullptr;   // reservation exhausted (VA, not physical)
+    }
+
+    const size_t      off  = it->first;
+    const CUdeviceptr addr = (CUdeviceptr) ((char *) p.base + off);
+    const int         phys = ggml_cuda_get_physical_device(device);
+
+    CUmemAllocationProp prop = {};
+    prop.type          = CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id   = phys;
+
+    CUmemGenericAllocationHandle handle;
+    cudaError_t err = cuMemCreate(&handle, aligned, &prop, 0);
+    if (err != cudaSuccess) {
+        (void) cudaGetLastError();
+        // The only reason physical allocation fails is that the low-priority MoE expert-cache arena
+        // holds the VRAM.  Unlike a cudaMalloc this needs no CONTIGUOUS block -- VMM physical is
+        // page-granular -- so yielding arena tables a few at a time is enough, which is exactly what the
+        // per-table stand-down gives us.  Same fail-soft policy as ggml_cuda_device_malloc.
+        while (moe_cache_shrink_step()) {
+            GGML_LOG_WARN("%s: VMM allocation of %.2f MiB failed on device %d; shrank the MoE arena and retrying\n",
+                          __func__, aligned / 1024.0 / 1024.0, device);
+            err = cuMemCreate(&handle, aligned, &prop, 0);
+            if (err == cudaSuccess) {
+                break;
+            }
+            (void) cudaGetLastError();
+        }
+        if (err != cudaSuccess && moe_cache_release_arena()) {
+            GGML_LOG_WARN("%s: VMM allocation of %.2f MiB still failed on device %d; released the MoE arena and retrying\n",
+                          __func__, aligned / 1024.0 / 1024.0, device);
+            err = cuMemCreate(&handle, aligned, &prop, 0);
+        }
+        if (err != cudaSuccess) {
+            (void) cudaGetLastError();
+            return nullptr;   // out of physical memory; caller falls back to cudaMalloc
+        }
+    }
+
+    CU_CHECK(cuMemMap(addr, aligned, 0, handle, 0));
+    CU_CHECK(cuMemRelease(handle));
+
+    CUmemAccessDesc access = {};
+    access.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    access.location.id   = phys;
+    access.flags         = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+    CU_CHECK(cuMemSetAccess(addr, aligned, &access, 1));
+
+    // commit the carve now that the mapping is live
+    const size_t remain = it->second - aligned;
+    p.free_blocks.erase(it);
+    if (remain > 0) {
+        p.free_blocks[off + aligned] = remain;
+    }
+    void * ptr = (void *) addr;
+    p.live[ptr] = aligned;
+    return ptr;
+}
+
+static bool ggml_cuda_vmm_owns(int device, const void * ptr) {
+    std::lock_guard<std::mutex> lock(g_vmm_pool_mutex);
+    const ggml_cuda_vmm_pool & p = g_vmm_pools[device];
+    if (!p.inited) {
+        return false;
+    }
+    const CUdeviceptr v = (CUdeviceptr) ptr;
+    const uintptr_t   vb = (uintptr_t) p.base;
+    const uintptr_t   vv = (uintptr_t) v;
+    return vv >= vb && vv < vb + p.size;
+}
+
+static void ggml_cuda_vmm_free(int device, void * ptr) {
+    std::lock_guard<std::mutex> lock(g_vmm_pool_mutex);
+    ggml_cuda_vmm_pool & p = g_vmm_pools[device];
+    auto it = p.live.find(ptr);
+    if (it == p.live.end()) {
+        return;
+    }
+    const size_t aligned = it->second;
+    p.live.erase(it);
+    ggml_cuda_set_device(device);
+    CU_CHECK(cuMemUnmap((CUdeviceptr) ptr, aligned));
+
+    // return the range to the free list, coalescing with the immediate neighbours
+    const size_t off = (size_t) ((char *) ptr - (char *) p.base);
+    size_t lo = off;
+    size_t hi = off + aligned;
+    // `erase` returns the iterator that follows the erased node, so it stays valid for the previous
+    // neighbour lookup below (reusing the pre-erase iterator would be use-after-free).
+    auto next = p.free_blocks.lower_bound(off);
+    if (next != p.free_blocks.end() && next->first == hi) {
+        hi = next->first + next->second;
+        next = p.free_blocks.erase(next);
+    }
+    if (next != p.free_blocks.begin()) {
+        auto prev = std::prev(next);
+        if (prev->first + prev->second == lo) {
+            lo = prev->first;
+            p.free_blocks.erase(prev);
+        }
+    }
+    p.free_blocks[lo] = hi - lo;
+}
