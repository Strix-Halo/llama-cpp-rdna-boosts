+static int moe_cache_validate_level() {
+    if (g_validate_level < 0) {
+        const char * env = getenv("MOE_EXPERT_CACHE_VALIDATE");
+        g_validate_level = env != NULL ? atoi(env) : 0;
+    }
+    return g_validate_level;
