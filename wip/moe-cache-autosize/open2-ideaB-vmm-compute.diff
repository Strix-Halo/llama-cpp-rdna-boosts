+// ---------------------------------------------------------------------------------------------
+// OPEN 2 / r42 (TODO #42): the per-device VMM allocator.
+//
+// One VA reservation per device, with physical mapped into it in `granularity`-sized steps.  There are
+// TWO levels, so the arena and the workspace (compute buffer) can share physical WITHOUT either losing
+// its VA:
+//
+//   reserve / release     VA only -- stable, no physical
+//   map / unmap           physical within an already-reserved VA range
+//   alloc / free          reserve+map / unmap+release, for objects that do not need a stable VA
+//
+// Why this shape: the MoE arena is stride-addressed (`(char *)t.arena + slot*t.expert_bytes`), so a
+// table's slab must be one CONTIGUOUS VA run, and a decode CUDA graph bakes that address into its launch
+// parameters, so the VA must survive a yield.  A table therefore RESERVES its slab once and only
+// MAP/UNMAPs the physical.  A compute-buffer growth unmaps the arena units it needs -- those units return
+// to THIS pool, not to the HIP allocator that `cudaFree` feeds -- and maps them into the workspace, so
+// growing is a pointer move rather than a free-then-malloc of a bigger contiguous block.  The tables
+// that are NOT unmapped keep their bytes: no whole-arena release is needed, and there is no second arena
+// and no copy.
+//
+// HIP-scoped (the gate returns false elsewhere) so no other backend's allocation changes.  Every mapping
+// is unmapped individually -- never a bulk unmap -- which is also what the ROCm workaround in
+// `ggml_cuda_pool_vmm` requires (ROCm/ROCR-Runtime#285).
+//
+// LOCKING: the pool mutex protects only the VA free list (`free_blocks`/`live`).  `map`/`unmap` take no
+// lock because they touch no shared state, and the yield they can trigger (`moe_cache_shrink_step` ->
+// `ggml_cuda_vmm_unmap`) must NOT run under it.
+struct ggml_cuda_vmm_pool {
+    bool                     inited      = false;
+    CUdeviceptr              base        = 0;
+    size_t                   size        = 0;
+    size_t                   granularity = 0;
+    std::map<void *, size_t> live;        // alloc()d ranges -> mapped size
+    std::map<size_t, size_t> free_blocks; // unused VA: offset -> size, coalesced
+};
+
+// A reservation costs no physical memory; keep it generous but small enough that several devices'
+// reservations coexist comfortably in the 47-bit address space.
+static const size_t GGML_CUDA_VMM_POOL_SIZE = 1ull << 36; // 64 GiB
+
+static std::mutex g_vmm_pool_mutex;
+static ggml_cuda_vmm_pool g_vmm_pools[GGML_CUDA_MAX_DEVICES];
+
+static bool ggml_cuda_compute_vmm_enabled() {
+#if defined(GGML_USE_HIP)
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char * env = getenv("GGML_CUDA_COMPUTE_VMM");
+        enabled = env != NULL ? atoi(env) : 0;
+    }
+    return enabled != 0;
+#else
+    return false;   // RDNA/ROCm-scoped: no other backend's allocation changes
+#endif
+}
+
+// The arena uses the same pool; `GGML_CUDA_COMPUTE_VMM` is the shared gate.
+bool ggml_cuda_vmm_enabled(int device) {
+    return ggml_cuda_compute_vmm_enabled() && ggml_cuda_info().devices[device].vmm;
+}
+
+static size_t ggml_cuda_vmm_align(size_t x, size_t a) {
+    return a * ((x + a - 1) / a);
+}
+
+static void ggml_cuda_vmm_pool_init_locked(int device, ggml_cuda_vmm_pool & p) {
+    if (p.inited) {
+        return;
+    }
+    p.granularity = ggml_cuda_info().devices[device].vmm_granularity;
+    if (p.granularity == 0) {
+        p.granularity = 2u * 1024 * 1024;
+    }
+    p.size = GGML_CUDA_VMM_POOL_SIZE;
+    ggml_cuda_set_device(device);
+    CU_CHECK(cuMemAddressReserve(&p.base, p.size, p.granularity, 0, 0));
+    p.free_blocks[0] = p.size;
+    p.inited = true;
+    GGML_LOG_INFO("%s: reserved %.2f GiB of VA (granularity %.2f MiB) on device %d for the VMM pool\n",
+                  __func__, p.size / 1024.0 / 1024.0 / 1024.0, p.granularity / 1024.0 / 1024.0, device);
+}
+
+// Carve `aligned` bytes of VA; returns the offset, or SIZE_MAX when the reservation is full (VA, not
+// physical).  Caller holds the pool mutex.
+static size_t ggml_cuda_vmm_carve_locked(ggml_cuda_vmm_pool & p, size_t aligned) {
+    for (auto it = p.free_blocks.begin(); it != p.free_blocks.end(); ++it) {
+        if (it->second < aligned) {
+            continue;
+        }
+        const size_t off    = it->first;
+        const size_t remain = it->second - aligned;
+        p.free_blocks.erase(it);
+        if (remain > 0) {
+            p.free_blocks[off + aligned] = remain;
+        }
+        return off;
+    }
+    return SIZE_MAX;
+}
+
+// Return a VA block, coalescing with the immediate neighbours.  Caller holds the pool mutex.  `erase`
+// returns the iterator that follows the erased node, so it stays valid for the previous-neighbour lookup
+// (reusing the pre-erase iterator would be use-after-free).
+static void ggml_cuda_vmm_return_locked(ggml_cuda_vmm_pool & p, size_t off, size_t aligned) {
+    size_t lo = off;
+    size_t hi = off + aligned;
+    auto next = p.free_blocks.lower_bound(off);
+    if (next != p.free_blocks.end() && next->first == hi) {
+        hi = next->first + next->second;
+        next = p.free_blocks.erase(next);
+    }
+    if (next != p.free_blocks.begin()) {
+        auto prev = std::prev(next);
+        if (prev->first + prev->second == lo) {
+            lo = prev->first;
+            p.free_blocks.erase(prev);
+        }
+    }
+    p.free_blocks[lo] = hi - lo;
+}
+
+// Map physical into an already-reserved VA range.  No pool lock (no shared state).
+static bool ggml_cuda_vmm_map_phys(int device, CUdeviceptr addr, size_t aligned) {
+    const int phys = ggml_cuda_get_physical_device(device);
+    CUmemAllocationProp prop = {};
+    prop.type          = CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id   = phys;
+
+    CUmemGenericAllocationHandle handle;
+    if (cuMemCreate(&handle, aligned, &prop, 0) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    CU_CHECK(cuMemMap(addr, aligned, 0, handle, 0));
+    CU_CHECK(cuMemRelease(handle));
+
+    CUmemAccessDesc access = {};
+    access.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    access.location.id   = phys;
+    access.flags         = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+    CU_CHECK(cuMemSetAccess(addr, aligned, &access, 1));
+    return true;
+}
+
+// Map physical, yielding the MoE arena when the pool is short.  The only reason physical allocation
+// fails is that the low-priority arena holds the VRAM; with the arena on this same pool a yield is an
+// `Unmap` whose units return here, so retrying succeeds without a contiguous block and without touching
+// the tables that were not yielded.  No pool lock is held here (see the locking note above).
+static bool ggml_cuda_vmm_map_with_yield(int device, CUdeviceptr addr, size_t aligned) {
+    if (ggml_cuda_vmm_map_phys(device, addr, aligned)) {
+        return true;
+    }
+    static const bool yield_wholesale = getenv("MOE_EXPERT_CACHE_YIELD_WHOLESALE") != nullptr;
+    if (yield_wholesale) {
+        if (moe_cache_release_arena()) {
+            GGML_LOG_WARN("%s: VMM map of %.2f MiB failed on device %d; released the WHOLE MoE arena and retrying\n",
+                          __func__, aligned / 1024.0 / 1024.0, device);
+            if (ggml_cuda_vmm_map_phys(device, addr, aligned)) {
+                return true;
+            }
+        }
+    } else {
+        while (moe_cache_shrink_step()) {
+            GGML_LOG_WARN("%s: VMM map of %.2f MiB failed on device %d; unmapped the largest MoE arena table and retrying\n",
+                          __func__, aligned / 1024.0 / 1024.0, device);
+            if (ggml_cuda_vmm_map_phys(device, addr, aligned)) {
+                return true;
+            }
+        }
+        if (moe_cache_release_arena()) {
+            GGML_LOG_WARN("%s: VMM map of %.2f MiB still failed on device %d; released the MoE arena and retrying\n",
+                          __func__, aligned / 1024.0 / 1024.0, device);
+            if (ggml_cuda_vmm_map_phys(device, addr, aligned)) {
+                return true;
+            }
+        }
+    }
+    moe_cache_validate("vmm-yield");
+    return false;
+}
+
+// Reserve `size` bytes of VA (no physical).  Stable: it stays valid until `release`.
+void * ggml_cuda_vmm_reserve(int device, size_t size) {
+    if (size == 0) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(g_vmm_pool_mutex);
+    ggml_cuda_vmm_pool & p = g_vmm_pools[device];
+    ggml_cuda_vmm_pool_init_locked(device, p);
+    const size_t aligned = ggml_cuda_vmm_align(size, p.granularity);
+    const size_t off = ggml_cuda_vmm_carve_locked(p, aligned);
+    if (off == SIZE_MAX) {
+        return nullptr;
+    }
+    return (void *) ((CUdeviceptr) ((char *) p.base + off));
+}
+
+void ggml_cuda_vmm_release(int device, void * ptr, size_t size) {
+    if (ptr == nullptr || size == 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_vmm_pool_mutex);
+    ggml_cuda_vmm_pool & p = g_vmm_pools[device];
+    const size_t aligned = ggml_cuda_vmm_align(size, p.granularity);
+    ggml_cuda_vmm_return_locked(p, (size_t) ((char *) ptr - (char *) p.base), aligned);
+}
+
+// Map physical into an already-reserved range, yielding the arena if needed.
+bool ggml_cuda_vmm_map(int device, void * ptr, size_t size) {
+    if (ptr == nullptr || size == 0) {
+        return false;
+    }
+    const size_t aligned = ggml_cuda_vmm_align(size, g_vmm_pools[device].granularity);
+    ggml_cuda_set_device(device);
+    return ggml_cuda_vmm_map_with_yield(device, (CUdeviceptr) ptr, aligned);
+}
+
+// Unmap the physical of a reserved range, giving the units back to the pool (the VA stays reserved).
+void ggml_cuda_vmm_unmap(int device, void * ptr, size_t size) {
+    if (ptr == nullptr || size == 0) {
+        return;
+    }
+    const size_t aligned = ggml_cuda_vmm_align(size, g_vmm_pools[device].granularity);
+    ggml_cuda_set_device(device);
+    CU_CHECK(cuMemUnmap((CUdeviceptr) ptr, aligned));
+}
+
+// Reserve + map.  Used by objects that do not need a stable VA (the compute buffer).
+void * ggml_cuda_vmm_alloc(int device, size_t size) {
+    void * ptr = ggml_cuda_vmm_reserve(device, size);
+    if (ptr == nullptr) {
+        return nullptr;
+    }
+    if (!ggml_cuda_vmm_map(device, ptr, size)) {
+        ggml_cuda_vmm_release(device, ptr, size);
+        return nullptr;
