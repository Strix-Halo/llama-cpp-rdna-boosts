diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index ac99e2871..ad411830c 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -38,6 +38,9 @@
 #include "ggml-cuda/mmf.cuh"
 #include "ggml-cuda/mmb.cuh"
 #include "ggml-cuda/moe-expert-cache.h"
+// Llama-Frankenstein VF (verify-step fusions not in r8: batched copy, GLU -> Q8_1)
+#include "ggml-cuda/lf-cpyb.cuh"
+#include "ggml-cuda/lf-gluq8.cuh"
 #include "ggml-cuda/mmq.cuh"
 #include "ggml-cuda/mmvf.cuh"
 #include "ggml-cuda/mmvq.cuh"
@@ -4725,6 +4728,39 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
 
     ggml_tensor * node = cgraph->nodes[i];
 
+    // Llama-Frankenstein batched copy (GGML_LF_CPY_BATCH, default on): consecutive same-layout f32 copies as one launch
+    if (node->op == GGML_OP_CPY) {
+        const int taken = ggml_cuda_lf_cpy_batch(*cuda_ctx, cgraph, i);
+        if (taken >= 2) {
+            return taken - 1;
+        }
+    }
+
+    // Llama-Frankenstein GLU -> Q8_1 (GGML_LF_GLU_Q8, default on): an F32 GLU whose next node (or the one after a reshape) is a
+    // 2..8-column mmvq matmul over it is marked here; its launcher then also writes the matmul's Q8_1 blocks
+    ggml_cuda_lf_glu_q8_mark(nullptr, nullptr);
+    if (node->op == GGML_OP_GLU && ggml_cuda_lf_glu_q8() && node->type == GGML_TYPE_F32 &&
+            node->src[0]->type == GGML_TYPE_F32 && ggml_is_contiguous(node) && node->ne[0] % QK8_1 == 0) {
+        const ggml_tensor * mm = nullptr;
+        if (i + 1 < cgraph->n_nodes && cgraph->nodes[i + 1]->op == GGML_OP_MUL_MAT) {
+            mm = cgraph->nodes[i + 1];
+        } else if (i + 2 < cgraph->n_nodes && cgraph->nodes[i + 1]->op == GGML_OP_RESHAPE &&
+                   cgraph->nodes[i + 2]->op == GGML_OP_MUL_MAT) {
+            mm = cgraph->nodes[i + 2];
+        }
+        if (mm != nullptr) {
+            const ggml_tensor * a = mm->src[1];
+            const ggml_tensor * a_root = a;
+            while (a_root->view_src != nullptr) {
+                a_root = a_root->view_src;
+            }
+            if (a_root == node && ggml_is_contiguous(a) && a->ne[0] % QK8_1 == 0 && ggml_nelements(a) == ggml_nelements(node) &&
+                    a->ne[1] >= 2 && ggml_is_quantized(mm->src[0]->type) && ggml_cuda_should_fuse_mul_mat_vec_q(mm, true)) {
+                ggml_cuda_lf_glu_q8_mark(node, mm);
+            }
+        }
+    }
+
     if (node->op == GGML_OP_MUL_MAT_ID && cuda_ctx->stream_context().concurrent_events.empty() &&
             ggml_cuda_match_shared_expert(cgraph, i, i + 3)) {
         const int outputs[] = { i + 2, i + 5 };
diff --git a/ggml/src/ggml-cuda/lf-cpyb.cu b/ggml/src/ggml-cuda/lf-cpyb.cu
new file mode 100644
index 000000000..62e45f928
--- /dev/null
+++ b/ggml/src/ggml-cuda/lf-cpyb.cu
@@ -0,0 +1,108 @@
+#include "lf-cpyb.cuh"
+
+namespace {
+
+constexpr int LF_CB_MAX = 16;
+
+bool lf_cb_on() {
+    static const bool on = getenv("GGML_LF_CPY_BATCH") == nullptr || atoi(getenv("GGML_LF_CPY_BATCH")) != 0; // default on
+    return on;
+}
+
+struct lf_cb_args {
+    const char * src[LF_CB_MAX];
+    char *       dst[LF_CB_MAX];
+    int64_t      sne[4], snb[4];   // source shape / byte strides (shared by the run)
+    int64_t      dne[4], dnb[4];   // destination shape / byte strides (shared by the run)
+};
+
+// blockIdx.y = copy; element i in ggml_cpy's flat order, located separately in the source and the destination layouts
+__global__ void lf_cb_kernel(const lf_cb_args a, const int64_t n) {
+    const int c = blockIdx.y;
+    const char * __restrict__ s = a.src[c];
+    char * __restrict__ d = a.dst[c];
+    for (int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; i < n; i += (int64_t) gridDim.x * blockDim.x) {
+        int64_t r = i;
+        const int64_t s0 = r % a.sne[0]; r /= a.sne[0];
+        const int64_t s1 = r % a.sne[1]; r /= a.sne[1];
+        const int64_t s2 = r % a.sne[2]; const int64_t s3 = r / a.sne[2];
+        r = i;
+        const int64_t d0 = r % a.dne[0]; r /= a.dne[0];
+        const int64_t d1 = r % a.dne[1]; r /= a.dne[1];
+        const int64_t d2 = r % a.dne[2]; const int64_t d3 = r / a.dne[2];
+        *(float *) (d + d0 * a.dnb[0] + d1 * a.dnb[1] + d2 * a.dnb[2] + d3 * a.dnb[3]) =
+            *(const float *) (s + s0 * a.snb[0] + s1 * a.snb[1] + s2 * a.snb[2] + s3 * a.snb[3]);
+    }
+}
+
+bool lf_cb_member(const ggml_tensor * n) {
+    if (n->op != GGML_OP_CPY) return false;
+    const ggml_tensor * s = n->src[0], * d = n->src[1];
+    return s && d && s->type == GGML_TYPE_F32 && d->type == GGML_TYPE_F32 && ggml_nelements(s) == ggml_nelements(d);
+}
+
+// nodes that compute nothing (the views a copy reads / writes through sit between the copies in the node list)
+bool lf_cb_noop(const ggml_tensor * n) {
+    return n->op == GGML_OP_VIEW || n->op == GGML_OP_RESHAPE || n->op == GGML_OP_PERMUTE || n->op == GGML_OP_TRANSPOSE ||
+           n->op == GGML_OP_NONE;
+}
+
+bool lf_cb_same(const ggml_tensor * a, const ggml_tensor * b) {
+    for (int k = 0; k < 4; ++k) if (a->ne[k] != b->ne[k] || a->nb[k] != b->nb[k]) return false;
+    return true;
+}
+
+// byte span touched by a (possibly strided) view
+void lf_cb_span(const ggml_tensor * t, uintptr_t & lo, uintptr_t & hi) {
+    lo = (uintptr_t) t->data;
+    size_t last = 0;
+    for (int k = 0; k < 4; ++k) last += (size_t) (t->ne[k] - 1) * t->nb[k];
+    hi = lo + last + ggml_type_size(t->type);
+}
+
+} // namespace
+
+int ggml_cuda_lf_cpy_batch(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, const int i) {
+    if (!lf_cb_on()) return 0;
+    ggml_tensor * first = cgraph->nodes[i];
+    if (!lf_cb_member(first)) return 0;
+    // the run: copies with the first one's layouts, possibly separated by no-op view nodes (consumed with the run)
+    int idx[LF_CB_MAX] = {i}, n = 1, last = i;
+    for (int j = i + 1; j < cgraph->n_nodes && n < LF_CB_MAX; ++j) {
+        const ggml_tensor * b = cgraph->nodes[j];
+        if (lf_cb_noop(b)) continue;
+        if (!lf_cb_member(b) || !lf_cb_same(b->src[0], first->src[0]) || !lf_cb_same(b->src[1], first->src[1])) break;
+        idx[n++] = j; last = j;
+    }
+    if (n < 2) return 0;
+    // the copies of a run must be independent: no destination may touch another copy's source or destination
+    for (int a = 0; a < n; ++a) {
+        uintptr_t dlo, dhi;
+        lf_cb_span(cgraph->nodes[idx[a]]->src[1], dlo, dhi);
+        for (int b = 0; b < n; ++b) {
+            uintptr_t lo, hi;
+            lf_cb_span(cgraph->nodes[idx[b]]->src[0], lo, hi);
+            if (dlo < hi && lo < dhi) return 0;
+            if (b != a) {
+                lf_cb_span(cgraph->nodes[idx[b]]->src[1], lo, hi);
+                if (dlo < hi && lo < dhi) return 0;
+            }
+        }
+    }
+    lf_cb_args args{};
+    for (int k = 0; k < 4; ++k) {
+        args.sne[k] = first->src[0]->ne[k]; args.snb[k] = first->src[0]->nb[k];
+        args.dne[k] = first->src[1]->ne[k]; args.dnb[k] = first->src[1]->nb[k];
+    }
+    for (int c = 0; c < n; ++c) {
+        args.src[c] = (const char *) cgraph->nodes[idx[c]]->src[0]->data;
+        args.dst[c] = (char *) cgraph->nodes[idx[c]]->src[1]->data;
+    }
+    const int64_t ne = ggml_nelements(first->src[0]);
+    const int blocks = (int) std::min<int64_t>(256, (ne + 255) / 256);
+    lf_cb_kernel<<<dim3(blocks, n), 256, 0, ctx.stream()>>>(args, ne);
+    CUDA_CHECK(cudaGetLastError());
+    static const bool dbg = getenv("GGML_LF_CPY_BATCH_DEBUG") != nullptr;
+    if (dbg) fprintf(stderr, "lf_cpy_batch: %d copies over nodes %d..%d (%lld elements each)\n", n, i, last, (long long) ne);
+    return last - i + 1;
+}
diff --git a/ggml/src/ggml-cuda/lf-cpyb.cuh b/ggml/src/ggml-cuda/lf-cpyb.cuh
new file mode 100644
index 000000000..d5c232a09
--- /dev/null
+++ b/ggml/src/ggml-cuda/lf-cpyb.cuh
@@ -0,0 +1,9 @@
+#pragma once
+#include "common.cuh"
+// Llama-Frankenstein batched copy (written by Claude): GGML_LF_CPY_BATCH (default on, =0 off) runs a run of consecutive f32 GGML_OP_CPY nodes that
+// share the source shape / strides and the destination shape / strides (only the data addresses differ) as one launch, e.g. the
+// per-position DeltaNet conv-state snapshots of a speculative verify batch (one copy per drafted position and layer).  Element
+// copies in ggml_cpy's flat order: bit-identical.
+// Returns the number of graph nodes it consumed (the copies plus the no-op view nodes between them, >= 2), or 0 when the node
+// at i does not start such a run.  GGML_LF_CPY_BATCH_DEBUG=1 prints every run.
+int ggml_cuda_lf_cpy_batch(ggml_backend_cuda_context & ctx, struct ggml_cgraph * cgraph, int i);
diff --git a/ggml/src/ggml-cuda/lf-gluq8.cu b/ggml/src/ggml-cuda/lf-gluq8.cu
new file mode 100644
index 000000000..8e5536610
--- /dev/null
+++ b/ggml/src/ggml-cuda/lf-gluq8.cu
@@ -0,0 +1,129 @@
+// Llama-Frankenstein GLU -> Q8_1 for the verify step (written by Claude), see lf-gluq8.cuh.
+#include "lf-gluq8.cuh"
+#include "quantize.cuh"
+
+#include <cstdio>
+#include <cstdlib>
+
+bool ggml_cuda_lf_glu_q8() {
+    static const bool on = getenv("GGML_LF_GLU_Q8") == nullptr || atoi(getenv("GGML_LF_GLU_Q8")) != 0; // default on
+    return on;
+}
+
+static const ggml_tensor * lf_glu_q8_node = nullptr;
+static const ggml_tensor * lf_glu_q8_mm   = nullptr;
+
+void ggml_cuda_lf_glu_q8_mark(const ggml_tensor * glu, const ggml_tensor * mm) {
+    lf_glu_q8_node = glu;
+    lf_glu_q8_mm   = mm;
+}
+
+const ggml_tensor * ggml_cuda_lf_glu_q8_marked(const ggml_tensor * glu) {
+    if (glu == nullptr || glu != lf_glu_q8_node) {
+        return nullptr;
+    }
+    lf_glu_q8_node = nullptr;
+    return lf_glu_q8_mm;
+}
+
+static __global__ void lf_glu_q8_cmp(const block_q8_1 * a, const block_q8_1 * b, const int64_t nblk_row,
+                                    const int64_t pitch_blk, const int64_t nblk, unsigned int * nbad) {
+    const int64_t idx = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (idx >= nblk) {
+        return;
+    }
+    const int64_t ib = (idx / nblk_row)*pitch_blk + idx % nblk_row;
+    const unsigned int * pa = (const unsigned int *) &a[ib];
+    const unsigned int * pb = (const unsigned int *) &b[ib];
+    bool same = true;
+    for (int k = 0; k < (int) (sizeof(block_q8_1)/sizeof(unsigned int)); ++k) {
+        same = same && pa[k] == pb[k];
+    }
+    if (!same) {
+        atomicAdd(nbad, 1u);
+    }
+}
+
+bool ggml_cuda_lf_glu_q8_check_on() {
+    static const bool on = getenv("GGML_LF_GLU_Q8_CHECK") != nullptr && atoi(getenv("GGML_LF_GLU_Q8_CHECK")) != 0;
+    return on;
+}
+
+static __global__ void lf_glu_q8_cmp_f32_kernel(const unsigned int * a, const unsigned int * b, const int64_t n, unsigned int * nbad) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i < n && a[i] != b[i]) {
+        atomicAdd(nbad, 1u);
+    }
+}
+
+void ggml_cuda_lf_glu_q8_cmp_f32(ggml_backend_cuda_context & ctx, const char * what, const float * a, const float * b, int64_t n) {
+    static long n_checks = 0, n_bad = 0;
+    cudaStream_t stream = ctx.stream();
+    ggml_cuda_pool_alloc<unsigned int> bad(ctx.pool(), 1);
+    CUDA_CHECK(cudaMemsetAsync(bad.get(), 0, sizeof(unsigned int), stream));
+    lf_glu_q8_cmp_f32_kernel<<<(n + 255)/256, 256, 0, stream>>>((const unsigned int *) a, (const unsigned int *) b, n, bad.get());
+    unsigned int h_bad = 0;
+    CUDA_CHECK(cudaMemcpyAsync(&h_bad, bad.get(), sizeof(unsigned int), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    n_checks++;
+    if (h_bad != 0) {
+        n_bad++;
+        fprintf(stderr, "LF_GLU_Q8_CHECK %s: %u of %lld floats differ\n", what, h_bad, (long long) n);
+    }
+    if (n_checks % 2000 == 0) {
+        fprintf(stderr, "LF_GLU_Q8_CHECK f32 summary: %ld checks, %ld with differences\n", n_checks, n_bad);
+    }
+}
+
+void ggml_cuda_lf_glu_q8_check(ggml_backend_cuda_context & ctx, const char * what, const ggml_tensor * view) {
+    static long n_checks = 0, n_bad = 0, n_miss = 0;
+    if (!ggml_cuda_lf_glu_q8_check_on()) {
+        return;
+    }
+    const ggml_tensor * root = view;
+    while (root->view_src != nullptr) {
+        root = root->view_src;
+    }
+    const size_t ts = ggml_type_size(view->type);
+    const int64_t ne10 = view->ne[0], ne11 = view->ne[1], ne12 = view->ne[2], ne13 = view->ne[3];
+    const int64_t s11 = view->nb[1]/ts, s12 = view->nb[2]/ts, s13 = view->nb[3]/ts;
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+    const size_t size = ne13*ne12 * ne11*ne10_padded * sizeof(block_q8_1)/QK8_1;
+    // look up without inserting (q8_1_cache_get would register an unwritten entry that the consumer then trusts)
+    const void * q8 = nullptr;
+    for (const auto & e : ctx.q8_1_cache) {
+        if (e.src1 == root && e.data == root->data && e.stream_no == ctx.curr_stream_no &&
+                e.ne10 == ne10 && e.ne11 == ne11 && e.ne12 == ne12 && e.ne13 == ne13 &&
+                e.s11 == s11 && e.s12 == s12 && e.s13 == s13) {
+            q8 = ctx.q8_1_arena + e.offset;
+            break;
+        }
+    }
+    n_checks++;
+    if (q8 == nullptr) {
+        n_miss++;
+        fprintf(stderr, "LF_GLU_Q8_CHECK %s %s: not in the quantize cache\n", what, view->name);
+        return;
+    }
+    cudaStream_t stream = ctx.stream();
+    ggml_cuda_pool_alloc<char> ref(ctx.pool(), size);
+    ggml_cuda_pool_alloc<unsigned int> bad(ctx.pool(), 1);
+    quantize_row_q8_1_cuda((const float *) view->data, nullptr, ref.get(), GGML_TYPE_Q8_0, ne10, s11, s12, s13,
+                           ne10_padded, ne11, ne12, ne13, stream);
+    CUDA_CHECK(cudaMemsetAsync(bad.get(), 0, sizeof(unsigned int), stream));
+    const int64_t nblk_row = ne10 / QK8_1;
+    const int64_t nblk = nblk_row * ne11*ne12*ne13;
+    lf_glu_q8_cmp<<<(nblk + 255)/256, 256, 0, stream>>>((const block_q8_1 *) q8, (const block_q8_1 *) ref.get(),
+                                                      nblk_row, ne10_padded/QK8_1, nblk, bad.get());
+    unsigned int h_bad = 0;
+    CUDA_CHECK(cudaMemcpyAsync(&h_bad, bad.get(), sizeof(unsigned int), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    if (h_bad != 0) {
+        n_bad++;
+        fprintf(stderr, "LF_GLU_Q8_CHECK %s %s [%lld x %lld]: %u of %lld blocks differ\n", what, view->name,
+                (long long) ne10, (long long) ne11, h_bad, (long long) nblk);
+    }
+    if (n_checks % 2000 == 0) {
+        fprintf(stderr, "LF_GLU_Q8_CHECK summary: %ld checks, %ld with differences, %ld misses\n", n_checks, n_bad, n_miss);
+    }
+}
diff --git a/ggml/src/ggml-cuda/lf-gluq8.cuh b/ggml/src/ggml-cuda/lf-gluq8.cuh
new file mode 100644
index 000000000..9f9e558fd
--- /dev/null
+++ b/ggml/src/ggml-cuda/lf-gluq8.cuh
@@ -0,0 +1,17 @@
+#pragma once
+#include "common.cuh"
+// Llama-Frankenstein GLU -> Q8_1 for the speculative verify step (written by Claude): an F32 GLU whose next node (or the one
+// after a reshape) is a 2..8-column mmvq matmul over it also writes that matmul's Q8_1 blocks into the quantize cache (the F32
+// output is still written), so the matmul skips its quantize_q8_1 launch.  Same math as quantize_q8_1: bit-identical.
+// GGML_LF_GLU_Q8=0 turns it off.  GGML_LF_GLU_Q8_CHECK=1 re-runs the unfused kernels and compares the bytes (debug; synchronizes).
+
+bool ggml_cuda_lf_glu_q8();
+bool ggml_cuda_lf_glu_q8_check_on();
+
+// try_fuse marks a GLU whose consumer mm qualifies; the GLU launcher takes the Q8_1 path when marked() returns mm
+void ggml_cuda_lf_glu_q8_mark(const ggml_tensor * glu, const ggml_tensor * mm);
+const ggml_tensor * ggml_cuda_lf_glu_q8_marked(const ggml_tensor * glu);
+
