+// Standard sparse FA on the MMA kernel: the launcher compacts the finite entries of the kq mask into
+// a per-(stream, query tile) index list (ggml_cuda_flash_attn_ext_compact_mask) and the kernel
+// gathers only those K/V rows.  This is upstream's n_kv_max mechanism; it was NVIDIA-only and is
+// enabled on AMD here.  GGML_CUDA_FA_SPARSE=0 is the A/B kill-switch, GGML_CUDA_FA_SPARSE_TRACE=1
+// prints one line per sparse selection (the harness that proves the path is actually exercised --
+// a green test-backend-ops run alone cannot tell sparse from the dense fallback).
+static inline bool ggml_cuda_fattn_sparse_enabled() {
+    static const bool enabled = []() {
+        const char * e = getenv("GGML_CUDA_FA_SPARSE");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return enabled;
+}
+
+static inline bool ggml_cuda_fattn_sparse_trace() {
+    static const bool trace = getenv("GGML_CUDA_FA_SPARSE_TRACE") != nullptr;
+    return trace;
+}
