+// Cross-platform warp ballot: CUDA's __ballot_sync takes a 32-bit member mask, HIP's requires a
+// 64-bit one (and returns 64 bits).  The result is truncated back to the low 32 lanes, which is all
+// the callers enumerate (WARP_SIZE == 32).
+static __device__ __forceinline__ uint32_t ggml_cuda_ballot(uint32_t mask, bool pred) {
+#if defined(GGML_USE_HIP)
+    return (uint32_t) __ballot_sync((unsigned long long) mask, pred ? 1 : 0);
+#else
+    return __ballot_sync(mask, pred ? 1 : 0);
+#endif // GGML_USE_HIP
+}
