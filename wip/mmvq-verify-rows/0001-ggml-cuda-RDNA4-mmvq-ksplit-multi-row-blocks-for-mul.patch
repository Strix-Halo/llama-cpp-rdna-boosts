From dc6813413a15ceeae5d6cdc395df057ffed286d3 Mon Sep 17 00:00:00 2001
From: briansp2020 <bsp2020@gmail.com>
Date: Sun, 27 Sep 2026 22:41:08 +0000
Subject: [PATCH 1/3] ggml-cuda: RDNA4 mmvq ksplit: multi-row blocks for
 multi-token (verify) batches

On RDNA4 the dense mmvq weight kernel ran one row per block (nwarps 1, and
calc_rows_per_block falls through to 1 for the RDNA tables), so a 2..8-token
verify batch re-read every q8_1 activation column once per weight row.
Compute several rows per block for ncols_dst 2..8 so the activation loads
are shared (the compiler CSEs them across the rows).

The rows per block come from a gfx1201 sweep of 1/2/4 rows over every
weight type, n = 2..8 and four shapes (4096x14336, 17408x5120, 5120x17408,
1024x5120):

  1 row : NVFP4 (4 rows was 40-60 % slower), Q1_0 (~10 % slower)
  2 rows: IQ2_XXS, IQ2_XS, IQ3_XXS, Q2_0, Q5_1
  4 rows: every other quantized type (GGML_MMVQ_RDNA4_WEIGHT_RPB)
  Q2_K  : 2 rows at 7..8 columns, where the 4-row kernel exceeds 256 VGPRs
          and spills to scratch

A per-(type, n) choice would gain at most 2.5 % more (IQ4_XS), so the rule
is per type.

The launch falls back to one row per block when
  - the row count is not a multiple of the block height (a multi-row block
    reads every row it owns, so it would read past the end of the weight), or
  - the launch would have fewer than GGML_MMVQ_RDNA4_WEIGHT_MIN_BLOCKS (512)
    blocks: short weights lose from multi-row blocks because the GPU is no
    longer filled (48-row SSM projections were 26 % slower at 4 rows; a
    sweep over 48/1024/2048/3072/17408 rows puts the cut at 512 blocks).
The fallback is chosen on the host and only instantiated for HIP builds at
2..8 columns.

Thread mapping, K order and warp reduction per row are unchanged and
ncols_dst == 1 is untouched, so W = 1..8 stay bit-identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/mmvq.cu | 91 ++++++++++++++++++++++++++++++++------
 1 file changed, 77 insertions(+), 14 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 0f5440d10..9c4fa256c 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -680,6 +680,47 @@ static constexpr __host__ __device__ int calc_rows_per_block_override(int rows_p
     return rows_per_block > 0 ? rows_per_block : calc_rows_per_block(ncols_dst, table_id, small_k, nwarps);
 }
 
+// rows per block for a dense mmvq *weight* launch (the ksplit kernel).  On RDNA4 a
+// multi-token (verify) batch computes several rows per block so the ncols_dst q8_1
+// activation columns are loaded once per block instead of once per row.  Each row's
+// accumulation (thread mapping, K order, warp reduction) is unchanged, so W = 1..8
+// stay bit-identical.
+#ifndef GGML_MMVQ_RDNA4_WEIGHT_RPB
+#define GGML_MMVQ_RDNA4_WEIGHT_RPB 4
+#endif
+// Multi-row blocks only pay off while the launch still has enough blocks to fill the GPU:
+// with fewer than this many blocks (e.g. 1024-row K/V or 48-row SSM projections at 4 rows)
+// the one-row launch is faster.
+#ifndef GGML_MMVQ_RDNA4_WEIGHT_MIN_BLOCKS
+#define GGML_MMVQ_RDNA4_WEIGHT_MIN_BLOCKS 512
+#endif
+static constexpr __host__ __device__ int calc_rows_per_block_weight(ggml_type type, int ncols_dst, int table_id, bool small_k, int nwarps) {
+    if (table_id == MMVQ_PARAMETERS_RDNA4 && ncols_dst >= 2 && ncols_dst <= MMVQ_MAX_BATCH_SIZE) {
+        constexpr int rpb_max = GGML_MMVQ_RDNA4_WEIGHT_RPB;
+        switch (type) {
+            // gfx1201 sweep (rows 1/2/4 x every type x n = 2..8 x 4 shapes): these gain
+            // nothing from more rows (NVFP4 loses 40-60 %, Q1_0 ~10 %) and keep one row.
+            case GGML_TYPE_NVFP4:
+            case GGML_TYPE_Q1_0:
+                return 1;
+            // these peak at 2 rows
+            case GGML_TYPE_IQ2_XXS:
+            case GGML_TYPE_IQ2_XS:
+            case GGML_TYPE_IQ3_XXS:
+            case GGML_TYPE_Q2_0:
+            case GGML_TYPE_Q5_1:
+                return rpb_max < 2 ? rpb_max : 2;
+            // Q2_K's dot product exceeds the 256-VGPR budget at 4 rows x 7..8 columns and
+            // spills to scratch; it keeps 2 rows there.
+            case GGML_TYPE_Q2_K:
+                return ncols_dst > 6 && rpb_max > 2 ? 2 : rpb_max;
+            default:
+                return rpb_max;
+        }
+    }
+    return calc_rows_per_block(ncols_dst, table_id, small_k, nwarps);
+}
+
 template <ggml_type type, int ncols_dst, bool has_fusion, bool small_k = false, bool halve_iters = false, int rows_per_block = 0>
 __launch_bounds__(calc_nwarps(type, ncols_dst, get_device_table_id(), small_k, halve_iters)*ggml_cuda_get_physical_warp_size(), 1)
