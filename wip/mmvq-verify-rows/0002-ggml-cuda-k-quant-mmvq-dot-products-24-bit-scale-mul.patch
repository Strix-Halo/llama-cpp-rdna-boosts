From 77d4a207447a91eb32a44feb2a633a00399394b5 Mon Sep 17 00:00:00 2001
From: briansp2020 <bsp2020@gmail.com>
Date: Sun, 27 Sep 2026 22:41:08 +0000
Subject: [PATCH 2/3] ggml-cuda: k-quant mmvq dot products: 24-bit scale
 multiply on HIP

The per-sub-block scale/min multiplies in the Q3_K/Q4_K/Q5_K/Q6_K mmvq dot
products (dp4a sum x 6-bit scale) compiled to v_mul_lo_u32, which is quarter
rate on RDNA (64 of the 574 instructions in the Q4_K 4-column loop). The
operands are small (|dp4a sum| <= 2^15, scales <= 2^6), so __mul24 is exact
and full rate. NVIDIA keeps the plain multiply (__mul24 is not faster
there). Results are bit-identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/vecdotq.cuh | 33 ++++++++++++++++++++++-----------
 1 file changed, 22 insertions(+), 11 deletions(-)

diff --git a/ggml/src/ggml-cuda/vecdotq.cuh b/ggml/src/ggml-cuda/vecdotq.cuh
index 9bad90846..43f78e546 100644
--- a/ggml/src/ggml-cuda/vecdotq.cuh
+++ b/ggml/src/ggml-cuda/vecdotq.cuh
@@ -2,6 +2,17 @@
 
 #include "common.cuh"
 
+// Scale multiply for the k-quant mmvq dot products. The operands are small (|dp4a sum| <= 2^15,
+// 6-bit scales/mins), so the 24-bit multiply is exact. On AMD it is full rate, where the 32-bit
+// v_mul_lo_u32 the compiler otherwise emits is quarter rate; NVIDIA keeps the plain multiply.
+static __device__ __forceinline__ int ggml_cuda_mul_small(const int a, const int b) {
+#if defined(GGML_USE_HIP)
+    return __mul24(a, b);
+#else
+    return a * b;
+#endif
+}
+
 #include <cstdint>
 
 static __device__ __forceinline__ int get_int_b1(const void * x, const int & i32) {
@@ -483,7 +494,7 @@ static __device__ __forceinline__ float vec_dot_q3_K_q8_1_impl_mmvq(
 
         const int vi = __vsubss4(vil, vih);
 
-        sumf += d8[i] * (ggml_cuda_dp4a(vi, u[i], 0) * sc); // SIMD dot product
+        sumf += d8[i] * ggml_cuda_mul_small(ggml_cuda_dp4a(vi, u[i], 0), sc); // SIMD dot product
     }
 
     return d3 * sumf;
@@ -531,8 +542,8 @@ static __device__ __forceinline__ float vec_dot_q4_K_q8_1_impl_vmmq(
         const int dot1 = ggml_cuda_dp4a(v1i, u[2*i+1], ggml_cuda_dp4a(v0i, u[2*i+0], 0)); // SIMD dot product
         const int dot2 = ggml_cuda_dp4a(0x01010101, u[2*i+1], ggml_cuda_dp4a(0x01010101, u[2*i+0], 0)); // sum of u
 
-        sumf_d += d8[i] * (dot1 * sc[i]);
-        sumf_m += d8[i] * (dot2 * m[i]);  // multiply constant part of q4_K with sum of q8_1 values
+        sumf_d += d8[i] * ggml_cuda_mul_small(dot1, sc[i]);
+        sumf_m += d8[i] * ggml_cuda_mul_small(dot2, m[i]);  // multiply constant part of q4_K with sum of q8_1 values
     }
 
     const float2 dm4f = __half22float2(dm4);
@@ -559,8 +570,8 @@ static __device__ __forceinline__ float vec_dot_q4_K_q8_1_impl_vmmq4(
         const int dot1 = ggml_cuda_dp4a(v1i, u[2*i+1], ggml_cuda_dp4a(v0i, u[2*i+0], 0)); // SIMD dot product
         const int dot2 = ggml_cuda_dp4a(0x01010101, u[2*i+1], ggml_cuda_dp4a(0x01010101, u[2*i+0], 0)); // sum of u
 
-        sumf_d += d8[i&1] * (dot1 * sc[i&1]);
-        sumf_m += d8[i&1] * (dot2 * m[i&1]);  // multiply constant part of q4_K with sum of q8_1 values
+        sumf_d += d8[i&1] * ggml_cuda_mul_small(dot1, sc[i&1]);
+        sumf_m += d8[i&1] * ggml_cuda_mul_small(dot2, m[i&1]);  // multiply constant part of q4_K with sum of q8_1 values
     }
 
     const float2 dm4f = __half22float2(dm4);
@@ -622,8 +633,8 @@ static __device__ __forceinline__ float vec_dot_q5_K_q8_1_impl_vmmq(
         const int dot1 = ggml_cuda_dp4a(v0i, u[2*i+0], ggml_cuda_dp4a(v1i, u[2*i+1], 0)); // SIMD dot product
         const int dot2 = ggml_cuda_dp4a(0x01010101, u[2*i+0], ggml_cuda_dp4a(0x01010101, u[2*i+1], 0)); // sum of u
 
-        sumf_d += d8[i] * (dot1 * sc[i]);
-        sumf_m += d8[i] * (dot2 * m[i]);
+        sumf_d += d8[i] * ggml_cuda_mul_small(dot1, sc[i]);
+        sumf_m += d8[i] * ggml_cuda_mul_small(dot2, m[i]);
 
     }
 
@@ -657,8 +668,8 @@ static __device__ __forceinline__ float vec_dot_q5_K_q8_1_impl_vmmq4(
         const int dot1 = ggml_cuda_dp4a(v0i, u[2*i+0], ggml_cuda_dp4a(v1i, u[2*i+1], 0)); // SIMD dot product
         const int dot2 = ggml_cuda_dp4a(0x01010101, u[2*i+0], ggml_cuda_dp4a(0x01010101, u[2*i+1], 0)); // sum of u
 
-        sumf_d += d8[i&1] * (dot1 * sc[i&1]);
-        sumf_m += d8[i&1] * (dot2 * m[i&1]);
+        sumf_d += d8[i&1] * ggml_cuda_mul_small(dot1, sc[i&1]);
+        sumf_m += d8[i&1] * ggml_cuda_mul_small(dot2, m[i&1]);
 
     }
 
@@ -716,7 +727,7 @@ static __device__ __forceinline__ float vec_dot_q6_K_q8_1_impl_mmvq(
 
         const int vi = __vsubss4((vil | vih), 0x20202020); // vi = (vil | vih) - 32
 
-        sumf += d8[i] * (ggml_cuda_dp4a(vi, u[i], 0) * sc); // SIMD dot product
+        sumf += d8[i] * ggml_cuda_mul_small(ggml_cuda_dp4a(vi, u[i], 0), sc); // SIMD dot product
     }
 
     return d*sumf;
@@ -745,7 +756,7 @@ static __device__ __forceinline__ float vec_dot_q6_K_q8_1_impl_mmvq_vdr2(
 
         const int vi = __vsubss4((vil | vih), 0x20202020); // vi = (vil | vih) - 32
 
-        sumf += d8[i&1] * (ggml_cuda_dp4a(vi, u[i], 0) * sc); // SIMD dot product
+        sumf += d8[i&1] * ggml_cuda_mul_small(ggml_cuda_dp4a(vi, u[i], 0), sc); // SIMD dot product
     }
 
     return d*sumf;
-- 
