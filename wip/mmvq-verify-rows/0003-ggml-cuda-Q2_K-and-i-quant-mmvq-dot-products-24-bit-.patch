From f4bac47d16a5adfbf53bf1735646bbf7fade455b Mon Sep 17 00:00:00 2001
From: briansp2020 <bsp2020@gmail.com>
Date: Sun, 27 Sep 2026 22:41:08 +0000
Subject: [PATCH 3/3] ggml-cuda: Q2_K and i-quant mmvq dot products: 24-bit
 scale multiply on HIP

Extend ggml_cuda_mul_small() to the Q2_K, IQ2_XXS/XS/S, IQ3_XXS/S and IQ4_XS
mmvq dot products (sumi x 4..6-bit scale; operands < 2^19, exact), removing
16-80 quarter-rate v_mul_lo_u32 per loop iteration on RDNA. Results are
bit-identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/vecdotq.cuh | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/ggml/src/ggml-cuda/vecdotq.cuh b/ggml/src/ggml-cuda/vecdotq.cuh
index 43f78e546..f71c93185 100644
--- a/ggml/src/ggml-cuda/vecdotq.cuh
+++ b/ggml/src/ggml-cuda/vecdotq.cuh
@@ -2,8 +2,8 @@
 
 #include "common.cuh"
 
-// Scale multiply for the k-quant mmvq dot products. The operands are small (|dp4a sum| <= 2^15,
-// 6-bit scales/mins), so the 24-bit multiply is exact. On AMD it is full rate, where the 32-bit
+// Scale multiply for the k-quant and i-quant mmvq dot products. The operands are small (|dp4a sums| < 2^19,
+// scales/mins <= 6 bits), so the 24-bit multiply is exact. On AMD it is full rate, where the 32-bit
 // v_mul_lo_u32 the compiler otherwise emits is quarter rate; NVIDIA keeps the plain multiply.
 static __device__ __forceinline__ int ggml_cuda_mul_small(const int a, const int b) {
 #if defined(GGML_USE_HIP)
@@ -398,7 +398,7 @@ static __device__ __forceinline__ float vec_dot_q2_K_q8_1_impl_mmvq(
 
         const int vi = (v >> (2*i)) & 0x03030303;
 
-        sumf_d += d8[i] * (ggml_cuda_dp4a(vi, u[i], 0) * (sc & 0xF)); // SIMD dot product
+        sumf_d += d8[i] * ggml_cuda_mul_small(ggml_cuda_dp4a(vi, u[i], 0), sc & 0xF); // SIMD dot product
 
         // fill int with 4x m
         int m = sc >> 4;
@@ -1360,7 +1360,7 @@ static __device__ __forceinline__ float vec_dot_iq2_xxs_q8_1(
     }
 
     const int ls = aux32 >> 27 | 1; // (scale * 2 + 1)
-    sumi = sumi * ls / 8;           // (sumi * scale + sumi / 2) / 4
+    sumi = ggml_cuda_mul_small(sumi, ls) / 8;           // (sumi * scale + sumi / 2) / 4
     const float d = __half2float(bq2->d) * __low2float(bq8_1[iqs/2].ds);
     return d * sumi;
 }
@@ -1401,7 +1401,7 @@ static __device__ __forceinline__ float vec_dot_iq2_xs_q8_1(
             sumi1 = ggml_cuda_dp4a(grid_h, u1, sumi1);
         }
     }
-    const int sumi = (sumi0*ls0 + sumi1*ls1 + (sumi0 + sumi1)/2)/4;
+    const int sumi = (ggml_cuda_mul_small(sumi0, ls0) + ggml_cuda_mul_small(sumi1, ls1) + (sumi0 + sumi1)/2)/4;
     const float d = __half2float(bq2->d) * __low2float(bq8_1[iqs/2].ds);
     return d * sumi;
 }
@@ -1448,7 +1448,7 @@ static __device__ __forceinline__ float vec_dot_iq2_s_q8_1(
             sumi1 = ggml_cuda_dp4a(grid_h, u1, sumi1);
         }
     }
-    const int sumi = (sumi0*ls0 + sumi1*ls1 + (sumi0 + sumi1)/2)/4;
+    const int sumi = (ggml_cuda_mul_small(sumi0, ls0) + ggml_cuda_mul_small(sumi1, ls1) + (sumi0 + sumi1)/2)/4;
 
     const float d = __half2float(bq2->d) * __low2float(bq8_1[iqs/2].ds);
     return d * sumi;
@@ -1487,7 +1487,7 @@ static __device__ __forceinline__ float vec_dot_iq3_xxs_q8_1(
     }
 
     const int ls = aux32 >> 28;
-    sumi = (ls*sumi + sumi/2)/2;
+    sumi = (ggml_cuda_mul_small(ls, sumi) + sumi/2)/2;
     const float d = __half2float(bq3->d) * __low2float(bq8_1[iqs/2].ds);
     return d * sumi;
 }
@@ -1529,7 +1529,7 @@ static __device__ __forceinline__ float vec_dot_iq3_s_q8_1(
         sumi = ggml_cuda_dp4a(grid_h, u1, sumi);
     }
 
-    sumi *= 1 + 2*((bq3->scales[iqs/4] >> ((iqs << 1) & 0x04)) & 0x0F);
+    sumi = ggml_cuda_mul_small(sumi, 1 + 2*((bq3->scales[iqs/4] >> ((iqs << 1) & 0x04)) & 0x0F));
 
     const float d = __half2float(bq3->d) * __low2float(bq8_1[iqs/2].ds);
     return d * sumi;
@@ -1661,7 +1661,7 @@ static __device__ __forceinline__ float vec_dot_iq4_xs_q8_1(
     }
 
     const int ls = ((bq4->scales_l[iqs/8] >> (iqs & 0x04)) & 0x0F) | (((bq4->scales_h >> (iqs/2)) & 0x03) << 4);
-    sumi *= ls - 32;
+    sumi = ggml_cuda_mul_small(sumi, ls - 32);
 
     const float d = __half2float(bq4->d) * __low2float(bq8_1[iqs/4].ds);
     return d * sumi;
-- 
